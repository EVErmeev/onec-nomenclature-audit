// Модуль управляемой формы внешнего отчёта «Контроль заполнения номенклатуры»
//
// Разместить на форме:
//   - ТабличныйДокумент "Результат"
//   - Флажок "УчитыватьПомеченныеНаУдаление"
//   - Флажок "УчитыватьГруппы"
//   - Флажок "ТолькоСПроблемами"
//   - Поле ввода "МаксимальноеКоличествоСтрок" (Число, значение по умолчанию = 1000)
//   - Кнопка "Сформировать" с командой "Сформировать"
//   - Командная панель с кнопкой "Сформировать"

&НаКлиенте
Переменная УчитыватьПомеченныеНаУдаление;

&НаКлиенте
Переменная УчитыватьГруппы;

&НаКлиенте
Переменная ТолькоСПроблемами;

&НаКлиенте
Переменная МаксимальноеКоличествоСтрок;

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УчитыватьПомеченныеНаУдаление = Ложь;
	УчитыватьГруппы = Ложь;
	ТолькоСПроблемами = Ложь;
	МаксимальноеКоличествоСтрок = 1000;
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	Настройки = Новый Структура;
	Настройки.Вставить("УчитыватьПомеченныеНаУдаление", УчитыватьПомеченныеНаУдаление);
	Настройки.Вставить("УчитыватьГруппы",               УчитыватьГруппы);
	Настройки.Вставить("ТолькоСПроблемами",             ТолькоСПроблемами);
	Настройки.Вставить("МаксимальноеКоличествоСтрок",   МаксимальноеКоличествоСтрок);
	СформироватьНаСервере(Настройки);
КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере(Настройки)
	Отказ = Ложь;
	ОтчетОбъект = РеквизитФормыВЗначение("Объект");
	Если ОтчетОбъект <> Неопределено Тогда
		ОтчетОбъект.СформироватьОтчет(Результат, Настройки, Отказ);
	КонецЕсли;
КонецПроцедуры
