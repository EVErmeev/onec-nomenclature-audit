Функция ПолучитьОписаниеВстроенныхПравил() Экспорт
	Т = Новый ТаблицаЗначений;
	Т.Колонки.Добавить("Код");
	Т.Колонки.Добавить("Наименование");
	Т.Колонки.Добавить("Критичность");
	Т.Колонки.Добавить("Вес", Новый ОписаниеТипов("Число"));
	Т.Колонки.Добавить("ПроверяемыйРеквизит");
	Т.Колонки.Добавить("Рекомендация");
	С = Т.Добавить(); С.Код="EMPTY_NAME"; С.Наименование="Пустое наименование"; С.Критичность="Критическая"; С.Вес=10; С.ПроверяемыйРеквизит="Наименование"; С.Рекомендация="Заполните наименование.";
	С = Т.Добавить(); С.Код="DELETION_MARK"; С.Наименование="Пометка удаления"; С.Критичность="Высокая"; С.Вес=7; С.ПроверяемыйРеквизит="ПометкаУдаления"; С.Рекомендация="Снимите пометку удаления.";
	С = Т.Добавить(); С.Код="DUPLICATE_NAME"; С.Наименование="Дубликат наименования"; С.Критичность="Высокая"; С.Вес=7; С.ПроверяемыйРеквизит="Наименование"; С.Рекомендация="Проверьте элементы с одинаковым наименованием.";
	С = Т.Добавить(); С.Код="DUPLICATE_CODE"; С.Наименование="Дубликат кода"; С.Критичность="Средняя"; С.Вес=5; С.ПроверяемыйРеквизит="Код"; С.Рекомендация="Проверьте элементы с одинаковым кодом.";
	С = Т.Добавить(); С.Код="NO_PARENT"; С.Наименование="Элемент вне группы"; С.Критичность="Средняя"; С.Вес=5; С.ПроверяемыйРеквизит="Родитель"; С.Рекомендация="Переместите в группу.";
	С = Т.Добавить(); С.Код="EMPTY_ARTICLE"; С.Наименование="Не заполнен артикул"; С.Критичность="Средняя"; С.Вес=3; С.ПроверяемыйРеквизит="Артикул"; С.Рекомендация="Укажите артикул.";
	С = Т.Добавить(); С.Код="EMPTY_KIND"; С.Наименование="Не заполнен вид номенклатуры"; С.Критичность="Высокая"; С.Вес=7; С.ПроверяемыйРеквизит="ВидНоменклатуры"; С.Рекомендация="Выберите вид номенклатуры.";
	С = Т.Добавить(); С.Код="EMPTY_UNIT"; С.Наименование="Не заполнена единица хранения"; С.Критичность="Средняя"; С.Вес=3; С.ПроверяемыйРеквизит="ЕдиницаИзмерения"; С.Рекомендация="Выберите единицу хранения.";
	С = Т.Добавить(); С.Код="EMPTY_VAT"; С.Наименование="Не заполнена ставка НДС"; С.Критичность="Средняя"; С.Вес=3; С.ПроверяемыйРеквизит="СтавкаНДС"; С.Рекомендация="Выберите ставку НДС.";
	С = Т.Добавить(); С.Код="EMPTY_CATEGORY"; С.Наименование="Не заполнена товарная категория"; С.Критичность="Средняя"; С.Вес=3; С.ПроверяемыйРеквизит="ТоварнаяКатегория"; С.Рекомендация="Выберите товарную категорию.";
	С = Т.Добавить(); С.Код="EMPTY_FIN_GROUP"; С.Наименование="Не заполнена группа фин. учёта"; С.Критичность="Информационная"; С.Вес=1; С.ПроверяемыйРеквизит="ГруппаФинансовогоУчета"; С.Рекомендация="Выберите группу.";
	С = Т.Добавить(); С.Код="EMPTY_TYPE"; С.Наименование="Не заполнен тип номенклатуры"; С.Критичность="Средняя"; С.Вес=3; С.ПроверяемыйРеквизит="ТипНоменклатуры"; С.Рекомендация="Проверьте ВидНоменклатуры.";
	С = Т.Добавить(); С.Код="EMPTY_FULL_NAME"; С.Наименование="Не заполнено наименование для печати"; С.Критичность="Информационная"; С.Вес=1; С.ПроверяемыйРеквизит="НаименованиеПолное"; С.Рекомендация="Заполните полное наименование.";
	С = Т.Добавить(); С.Код="EMPTY_SEARCH_CODE"; С.Наименование="Не заполнен код для поиска"; С.Критичность="Информационная"; С.Вес=1; С.ПроверяемыйРеквизит="КодДляПоиска"; С.Рекомендация="Заполните код для поиска.";
	С = Т.Добавить(); С.Код="EMPTY_PRODUCER"; С.Наименование="Не заполнен производитель"; С.Критичность="Средняя"; С.Вес=3; С.ПроверяемыйРеквизит="Производитель"; С.Рекомендация="Выберите производителя.";
	С = Т.Добавить(); С.Код="EMPTY_PRICE_GROUP"; С.Наименование="Не заполнена ценовая группа"; С.Критичность="Средняя"; С.Вес=3; С.ПроверяемыйРеквизит="ЦеноваяГруппа"; С.Рекомендация="Выберите ценовую группу.";
	С = Т.Добавить(); С.Код="NO_PROBLEMS"; С.Наименование="Проблем не обнаружено"; С.Критичность="Информационная"; С.Вес=0; С.ПроверяемыйРеквизит=""; С.Рекомендация="";
	Возврат Т;
КонецФункции

Функция ПолучитьПравило(Код) Экспорт
	Правила = ПолучитьОписаниеВстроенныхПравил();
	Рез = Правила.Найти(Код, "Код");
	Если Рез = Неопределено Тогда
		Рез = Правила.Найти("EMPTY_NAME", "Код");
	КонецЕсли;
	Возврат Рез;
КонецФункции

#КонецОбласти

#Область ТекстыЗапросов

Функция НормализоватьЛимит(МаксСтрок) Экспорт
	Если МаксСтрок = Неопределено Тогда МаксСтрок = 1000; КонецЕсли;
	МаксСтрок = Цел(МаксСтрок);
	Если МаксСтрок < 1 Тогда МаксСтрок = 1; КонецЕсли;
	Если МаксСтрок > 100000 Тогда МаксСтрок = 100000; КонецЕсли;
	Возврат МаксСтрок;
КонецФункции

Функция ПостроитьОсновнойЗапрос(УчитыватьПомеченные, УчитыватьГруппы, МаксСтрок) Экспорт
	Лимит = НормализоватьЛимит(МаксСтрок);
	ТекстЛимита = Формат(Лимит, "ЧГ=0");
	Т = "ВЫБРАТЬ ПЕРВЫЕ " + ТекстЛимита + "
	|	Номенклатура.Ссылка КАК Ссылка, Номенклатура.Код КАК Код,
	|	Номенклатура.Наименование КАК Наименование, Номенклатура.Родитель КАК Родитель,
	|	Номенклатура.ЭтоГруппа КАК ЭтоГруппа, Номенклатура.ПометкаУдаления КАК ПометкаУдаления,
	|	Номенклатура.Артикул КАК Артикул, Номенклатура.ВидНоменклатуры КАК ВидНоменклатуры,
	|	Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения, Номенклатура.СтавкаНДС КАК СтавкаНДС,
	|	Номенклатура.ТоварнаяКатегория КАК ТоварнаяКатегория, Номенклатура.ГруппаФинансовогоУчета КАК ГруппаФинансовогоУчета,
	|	Номенклатура.ТипНоменклатуры КАК ТипНоменклатуры, Номенклатура.НаименованиеПолное КАК НаименованиеПолное,
	|	Номенклатура.Производитель КАК Производитель, Номенклатура.ЦеноваяГруппа КАК ЦеноваяГруппа,
	|	Номенклатура.КодДляПоиска КАК КодДляПоиска
	|ИЗ Справочник.Номенклатура КАК Номенклатура
	|ГДЕ 1=1";
	Если НЕ УчитыватьГруппы Тогда Т = Т + " И Номенклатура.ЭтоГруппа = ЛОЖЬ"; КонецЕсли;
	Если НЕ УчитыватьПомеченные Тогда Т = Т + " И НЕ Номенклатура.ПометкаУдаления"; КонецЕсли;
	Т = Т + " УПОРЯДОЧИТЬ ПО Номенклатура.Наименование";
	Возврат Т;
КонецФункции

Функция СоздатьЗапросДублейНаименований(УчитыватьПомеченные, УчитыватьГруппы) Экспорт
	Т = "ВЫБРАТЬ Номенклатура.Наименование КАК Наименование, Номенклатура.ЭтоГруппа КАК ЭтоГруппа,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Номенклатура.Ссылка) КАК КоличествоДублей
	|ИЗ Справочник.Номенклатура КАК Номенклатура
	|ГДЕ Номенклатура.Наименование <> &ПустаяСтрока";
	Если НЕ УчитыватьГруппы Тогда Т = Т + " И НЕ Номенклатура.ЭтоГруппа"; КонецЕсли;
	Если НЕ УчитыватьПомеченные Тогда Т = Т + " И НЕ Номенклатура.ПометкаУдаления"; КонецЕсли;
	Т = Т + " СГРУППИРОВАТЬ ПО Номенклатура.Наименование, Номенклатура.ЭтоГруппа
	|ИМЕЮЩИЕ КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Номенклатура.Ссылка) > 1";
	З = Новый Запрос(Т); З.УстановитьПараметр("ПустаяСтрока", ""); Возврат З;
КонецФункции

Функция СоздатьЗапросДублейКодов(УчитыватьПомеченные, УчитыватьГруппы) Экспорт
	Т = "ВЫБРАТЬ Номенклатура.Код КАК Код, Номенклатура.ЭтоГруппа КАК ЭтоГруппа,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Номенклатура.Ссылка) КАК КоличествоДублей
	|ИЗ Справочник.Номенклатура КАК Номенклатура
	|ГДЕ Номенклатура.Код <> &ПустаяСтрока";
	Если НЕ УчитыватьГруппы Тогда Т = Т + " И НЕ Номенклатура.ЭтоГруппа"; КонецЕсли;
	Если НЕ УчитыватьПомеченные Тогда Т = Т + " И НЕ Номенклатура.ПометкаУдаления"; КонецЕсли;
	Т = Т + " СГРУППИРОВАТЬ ПО Номенклатура.Код, Номенклатура.ЭтоГруппа
	|ИМЕЮЩИЕ КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Номенклатура.Ссылка) > 1";
	З = Новый Запрос(Т); З.УстановитьПараметр("ПустаяСтрока", ""); Возврат З;
КонецФункции

#КонецОбласти

#Область ОбработкаРезультатов

Функция СоздатьТаблицуРезультата() Экспорт
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТЗ.Колонки.Добавить("Код"); ТЗ.Колонки.Добавить("Наименование");
	ТЗ.Колонки.Добавить("Родитель", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТЗ.Колонки.Добавить("КодПроблемы"); ТЗ.Колонки.Добавить("Проблема");
	ТЗ.Колонки.Добавить("Критичность"); ТЗ.Колонки.Добавить("Вес", Новый ОписаниеТипов("Число"));
	ТЗ.Колонки.Добавить("ПроверяемыйРеквизит"); ТЗ.Колонки.Добавить("ТекущееЗначение");
	ТЗ.Колонки.Добавить("Рекомендация");
	Возврат ТЗ;
КонецФункции

Процедура ДобавитьПроблему(ТЗ, Данные, КодПравила, ТекущееЗначение = "") Экспорт
	П = ПолучитьПравило(КодПравила);
	С = ТЗ.Добавить(); С.Ссылка = Данные.Ссылка; С.Код = Данные.Код;
	С.Наименование = Данные.Наименование; С.Родитель = Данные.Родитель;
	С.КодПроблемы = П.Код; С.Проблема = П.Наименование;
	С.Критичность = П.Критичность; С.Вес = П.Вес;
	С.ПроверяемыйРеквизит = П.ПроверяемыйРеквизит;
	С.ТекущееЗначение = ТекущееЗначение; С.Рекомендация = П.Рекомендация;
КонецПроцедуры

Процедура ДобавитьСтрокуБезПроблем(ТЗ, Данные) Экспорт
	С = ТЗ.Добавить(); С.Ссылка = Данные.Ссылка; С.Код = Данные.Код;
	С.Наименование = Данные.Наименование; С.Родитель = Данные.Родитель;
	С.КодПроблемы = "NO_PROBLEMS"; С.Проблема = "Проблем не обнаружено";
	С.Критичность = "Информационная"; С.Вес = 0;
	С.ПроверяемыйРеквизит = ""; С.ТекущееЗначение = ""; С.Рекомендация = "";
КонецПроцедуры

Функция НайтиДублиПоЗначению(Таб, Данные, Поле, ПолеГруппы) Экспорт
	К = Новый Структура; К.Вставить(Поле, Данные[Поле]); К.Вставить(ПолеГруппы, Данные[ПолеГруппы]);
	Р = Таб.НайтиСтроки(К); Если Р.Количество() > 0 Тогда Возврат Р[0]; КонецЕсли;
	Возврат Неопределено;
КонецФункции

Процедура ВыполнитьПроверкиГруппы(Д, ТЗ, ДН, ДК) Экспорт
	Если НЕ ЗначениеЗаполнено(Д.Наименование) Тогда ДобавитьПроблему(ТЗ, Д, "EMPTY_NAME"); КонецЕсли;
	Если Д.ПометкаУдаления Тогда ДобавитьПроблему(ТЗ, Д, "DELETION_MARK", "Да"); КонецЕсли;
	Если ДН <> Неопределено Тогда
		С = НайтиДублиПоЗначению(ДН, Д, "Наименование", "ЭтоГруппа");
		Если С <> Неопределено Тогда ДобавитьПроблему(ТЗ, Д, "DUPLICATE_NAME", Д.Наименование); КонецЕсли;
	КонецЕсли;
	Если ДК <> Неопределено И ЗначениеЗаполнено(Д.Код) Тогда
		С = НайтиДублиПоЗначению(ДК, Д, "Код", "ЭтоГруппа");
		Если С <> Неопределено Тогда ДобавитьПроблему(ТЗ, Д, "DUPLICATE_CODE", Д.Код); КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура ВыполнитьПроверкиЭлемента(Д, ТЗ, ДН, ДК) Экспорт
	Если НЕ ЗначениеЗаполнено(Д.Наименование) Тогда ДобавитьПроблему(ТЗ, Д, "EMPTY_NAME"); КонецЕсли;
	Если Д.ПометкаУдаления Тогда ДобавитьПроблему(ТЗ, Д, "DELETION_MARK", "Да"); КонецЕсли;
	Если ДН <> Неопределено Тогда
		С = НайтиДублиПоЗначению(ДН, Д, "Наименование", "ЭтоГруппа");
		Если С <> Неопределено Тогда ДобавитьПроблему(ТЗ, Д, "DUPLICATE_NAME", Д.Наименование); КонецЕсли;
	КонецЕсли;
	Если ДК <> Неопределено И ЗначениеЗаполнено(Д.Код) Тогда
		С = НайтиДублиПоЗначению(ДК, Д, "Код", "ЭтоГруппа");
		Если С <> Неопределено Тогда ДобавитьПроблему(ТЗ, Д, "DUPLICATE_CODE", Д.Код); КонецЕсли;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Д.Родитель) Тогда ДобавитьПроблему(ТЗ, Д, "NO_PARENT"); КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Д.Артикул) Тогда ДобавитьПроблему(ТЗ, Д, "EMPTY_ARTICLE"); КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Д.ВидНоменклатуры) Тогда ДобавитьПроблему(ТЗ, Д, "EMPTY_KIND"); КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Д.ЕдиницаИзмерения) Тогда ДобавитьПроблему(ТЗ, Д, "EMPTY_UNIT"); КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Д.СтавкаНДС) Тогда ДобавитьПроблему(ТЗ, Д, "EMPTY_VAT"); КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Д.ТоварнаяКатегория) Тогда ДобавитьПроблему(ТЗ, Д, "EMPTY_CATEGORY"); КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Д.ГруппаФинансовогоУчета) Тогда ДобавитьПроблему(ТЗ, Д, "EMPTY_FIN_GROUP"); КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Д.ТипНоменклатуры) Тогда ДобавитьПроблему(ТЗ, Д, "EMPTY_TYPE"); КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Д.НаименованиеПолное) Тогда ДобавитьПроблему(ТЗ, Д, "EMPTY_FULL_NAME"); КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Д.КодДляПоиска) Тогда ДобавитьПроблему(ТЗ, Д, "EMPTY_SEARCH_CODE"); КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Д.Производитель) Тогда ДобавитьПроблему(ТЗ, Д, "EMPTY_PRODUCER"); КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Д.ЦеноваяГруппа) Тогда ДобавитьПроблему(ТЗ, Д, "EMPTY_PRICE_GROUP"); КонецЕсли;
КонецПроцедуры

// Строит сводку по результату
Функция ПостроитьСводку(ТЗ) Экспорт
	Сводка = Новый ТаблицаЗначений;
	Сводка.Колонки.Добавить("КодПроблемы"); Сводка.Колонки.Добавить("Проблема");
	Сводка.Колонки.Добавить("Критичность"); Сводка.Колонки.Добавить("Карточек", Новый ОписаниеТипов("Число"));
	Сводка.Колонки.Добавить("Проблем", Новый ОписаниеТипов("Число"));
	Сводка.Колонки.Добавить("Доля", Новый ОписаниеТипов("Число"));
	Если ТЗ.Количество() = 0 Тогда Возврат Сводка; КонецЕсли;
	ВсегоКарточек = 0; Уник = Новый Соответствие;
	Для Каждого С Из ТЗ Цикл
		Кл = Строка(С.Ссылка);
		Если Уник[Кл] = Неопределено Тогда Уник.Вставить(Кл, Истина); ВсегоКарточек = ВсегоКарточек + 1; КонецЕсли;
	КонецЦикла;
	Группы = Новый ТаблицаЗначений; Группы.Колонки.Добавить("КодПроблемы"); Группы.Колонки.Добавить("Проблема");
	Группы.Колонки.Добавить("Критичность"); Группы.Колонки.Добавить("Карточек"); Группы.Колонки.Добавить("Проблем");
	Группы.Колонки.Добавить("УникКарточки");
	Для Каждого С Из ТЗ Цикл
		Кл = Строка(С.Ссылка);
		Г = Группы.Найти(С.КодПроблемы, "КодПроблемы");
		Если Г = Неопределено Тогда
			Г = Группы.Добавить(); Г.КодПроблемы = С.КодПроблемы; Г.Проблема = С.Проблема;
			Г.Критичность = С.Критичность; Г.Карточек = 0; Г.Проблем = 0; Г.УникКарточки = Новый Соответствие;
		КонецЕсли;
		Г.Проблем = Г.Проблем + 1;
		Если Г.УникКарточки[Кл] = Неопределено Тогда Г.УникКарточки.Вставить(Кл, Истина); Г.Карточек = Г.Карточек + 1; КонецЕсли;
	КонецЦикла;
	Для Каждого Г Из Группы Цикл
		Р = Сводка.Добавить(); Р.КодПроблемы = Г.КодПроблемы; Р.Проблема = Г.Проблема;
		Р.Критичность = Г.Критичность; Р.Карточек = Г.Карточек; Р.Проблем = Г.Проблем;
		Р.Доля = Окр(Г.Карточек / ВсегоКарточек * 100, 1);
	КонецЦикла;
	Возврат Сводка;
КонецФункции

#КонецОбласти

#Область ФормированиеОтчета

Функция ВыполнитьЗапросДублей(Запрос, ИмяПроверки, Диагностика, Отказ) Экспорт
	Попытка Возврат Запрос.Выполнить().Выгрузить();
	Исключение
		Отказ = Истина;
		Диагностика = Диагностика + "Этап: " + ИмяПроверки + Символы.ПС + "Ошибка: " + ОписаниеОшибки() + Символы.ПС + "Текст:" + Запрос.Текст + Символы.ПС;
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Процедура СформироватьОтчет(РезультатТЗ, Настройки, Статус, ТехОшибка, Проверено, СПроблемами, Проблем, СтрокРез, ЕстьОшибка, Отказ) Экспорт
	Попытка
		РезультатТЗ.Очистить(); Статус = ""; ТехОшибка = ""; ЕстьОшибка = Ложь;
		Проверено = 0; СПроблемами = 0; Проблем = 0; СтрокРез = 0; Диагностика = "";
		М = НормализоватьЛимит(Настройки.МаксимумКарточек);
		ТО = ПостроитьОсновнойЗапрос(Настройки.УчитыватьПомеченныеНаУдаление, Настройки.УчитыватьГруппы, М);
		Диагностика = Диагностика + "Параметры: П=" + Настройки.УчитыватьПомеченныеНаУдаление + " Г=" + Настройки.УчитыватьГруппы + " ТП=" + Настройки.ТолькоСПроблемами + " Л=" + М + Символы.ПС;
		ЗДН = СоздатьЗапросДублейНаименований(Настройки.УчитыватьПомеченныеНаУдаление, Настройки.УчитыватьГруппы);
		ЗДК = СоздатьЗапросДублейКодов(Настройки.УчитыватьПомеченныеНаУдаление, Настройки.УчитыватьГруппы);
		ДН = ВыполнитьЗапросДублей(ЗДН, "ДублиНаименований", Диагностика, Отказ);
		Если Отказ Тогда Статус = "Ошибка формирования"; ТехОшибка = Диагностика; ЕстьОшибка = Истина; Возврат; КонецЕсли;
		ДК = ВыполнитьЗапросДублей(ЗДК, "ДублиКодов", Диагностика, Отказ);
		Если Отказ Тогда Статус = "Ошибка формирования"; ТехОшибка = Диагностика; ЕстьОшибка = Истина; Возврат; КонецЕсли;
		З = Новый Запрос(ТО); В = З.Выполнить().Выбрать();
		Пока В.Следующий() Цикл
			Д = Новый Структура; Д.Вставить("Ссылка", В.Ссылка); Д.Вставить("Код", В.Код); Д.Вставить("Наименование", В.Наименование);
			Д.Вставить("Родитель", В.Родитель); Д.Вставить("ЭтоГруппа", В.ЭтоГруппа); Д.Вставить("ПометкаУдаления", В.ПометкаУдаления);
			Д.Вставить("Артикул", В.Артикул); Д.Вставить("ВидНоменклатуры", В.ВидНоменклатуры); Д.Вставить("ЕдиницаИзмерения", В.ЕдиницаИзмерения);
			Д.Вставить("СтавкаНДС", В.СтавкаНДС); Д.Вставить("ТоварнаяКатегория", В.ТоварнаяКатегория); Д.Вставить("ГруппаФинансовогоУчета", В.ГруппаФинансовогоУчета);
			Д.Вставить("ТипНоменклатуры", В.ТипНоменклатуры); Д.Вставить("НаименованиеПолное", В.НаименованиеПолное);
			Д.Вставить("Производитель", В.Производитель); Д.Вставить("ЦеноваяГруппа", В.ЦеноваяГруппа); Д.Вставить("КодДляПоиска", В.КодДляПоиска);
			Проверено = Проверено + 1;
			ПК = СоздатьТаблицуРезультата();
			Если Д.ЭтоГруппа Тогда ВыполнитьПроверкиГруппы(Д, ПК, ДН, ДК); Иначе ВыполнитьПроверкиЭлемента(Д, ПК, ДН, ДК); КонецЕсли;
			Если ПК.Количество() > 0 Тогда
				СПроблемами = СПроблемами + 1; Проблем = Проблем + ПК.Количество();
				Для Каждого С Из ПК Цикл НР = РезультатТЗ.Добавить(); ЗаполнитьЗначенияСвойств(НР, С); КонецЦикла;
			ИначеЕсли НЕ Настройки.ТолькоСПроблемами Тогда
				ДобавитьСтрокуБезПроблем(РезультатТЗ, Д);
			КонецЕсли;
		КонецЦикла;
		СтрокРез = РезультатТЗ.Количество();
		Статус = "Сформировано успешно";
	Исключение
		Отказ = Истина; ЕстьОшибка = Истина; Статус = "Ошибка формирования";
		ТехОшибка = "Этап: ОсновнойЗапрос" + Символы.ПС + "Ошибка: " + ОписаниеОшибки() + Символы.ПС + "Текст:" + ТО + Символы.ПС + Диагностика;
	КонецПопытки;
КонецПроцедуры


// Экспорт результата в CSV (UTF-8 BOM)
Процедура ЭкспортироватьCSV(ТЗ, ПутьКФайлу, Настройки, Проверено, СПроблемами, Проблем, СтрокРез) Экспорт
	Т = ""; Р = ";"; К = """";
	Т = Т + "Контроль заполнения номенклатуры" + Символы.ПС;
	Т = Т + "Дата:" + Р + Строка(ТекущаяДата()) + Символы.ПС;
	Т = Т + "Помеченные:" + Р + Строка(Настройки.УчитыватьПомеченныеНаУдаление) + Символы.ПС;
	Т = Т + "Группы:" + Р + Строка(Настройки.УчитыватьГруппы) + Символы.ПС;
	Т = Т + "Проблемы:" + Р + Строка(Настройки.ТолькоСПроблемами) + Символы.ПС;
	Т = Т + "Лимит:" + Р + Строка(Настройки.МаксимумКарточек) + Символы.ПС + Символы.ПС;
	Т = Т + "Проверено:" + Р + Строка(Проверено) + Символы.ПС;
	Т = Т + "С проблемами:" + Р + Строка(СПроблемами) + Символы.ПС;
	Т = Т + "Проблем:" + Р + Строка(Проблем) + Символы.ПС;
	Т = Т + "Строк:" + Р + Строка(СтрокРез) + Символы.ПС + Символы.ПС;
	Т = Т + "Код" + Р + "Наименование" + Р + "КодПроблемы" + Р + "Проблема" + Р + "Критичность" + Р + "Рекомендация" + Символы.ПС;
	Для Каждого С Из ТЗ Цикл
		Т = Т + ЭкранироватьCSV(С.Код, К, Р) + Р;
		Т = Т + ЭкранироватьCSV(С.Наименование, К, Р) + Р;
		Т = Т + ЭкранироватьCSV(С.КодПроблемы, К, Р) + Р;
		Т = Т + ЭкранироватьCSV(С.Проблема, К, Р) + Р;
		Т = Т + ЭкранироватьCSV(С.Критичность, К, Р) + Р;
		Т = Т + ЭкранироватьCSV(С.Рекомендация, К, Р) + Символы.ПС;
	КонецЦикла;
	ЗТ = Новый ЗаписьТекста(ПутьКФайлу, "UTF-8");
	ЗТ.Записать(Т); ЗТ.Закрыть();
КонецПроцедуры

Функция ЭкранироватьCSV(ТекстCSV, Кавычка, Разделитель) Экспорт
	С = Строка(ТекстCSV);
	Если Найти(С, Кавычка) > 0 Тогда С = СтрЗаменить(С, Кавычка, Кавычка + Кавычка); КонецЕсли;
	Если Найти(С, Разделитель) > 0 Или Найти(С, Символы.ПС) > 0 Тогда С = Кавычка + С + Кавычка; КонецЕсли;
	Возврат С;
КонецФункции

#КонецОбласти
