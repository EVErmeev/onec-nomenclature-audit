Процедура ЭкспортироватьXLSX(ТЗ, ПутьКФайлу, Настройки, Проверено, СПроблемами, Проблем, СтрокПолн, СтрокОтобр, ФильтрКрит, ФильтрКод, ФильтрПробл, ФильтрГр) Экспорт
	ТД = Новый ТабличныйДокумент;
	ТД.АвтоМасштаб = Истина;
	ОблЗаг = ТД.Области.Добавить(); ОблЗаг.Объединить(1,1,1,11);
	ОблЗаг.Текст = "Контроль заполнения номенклатуры"; ОблЗаг.Шрифт = Новый Шрифт(ТД.Шрифт, , Истина, , 14);
	ОблШ = ТД.Области.Добавить();
	ОблШ.Область(1,1).Текст = "Ссылка"; ОблШ.Область(1,2).Текст = "Код"; ОблШ.Область(1,3).Текст = "Наименование";
	ОблШ.Область(1,4).Текст = "Родитель"; ОблШ.Область(1,5).Текст = "Код проблемы"; ОблШ.Область(1,6).Текст = "Проблема";
	ОблШ.Область(1,7).Текст = "Критичность"; ОблШ.Область(1,8).Текст = "Вес";
	ОблШ.Область(1,9).Текст = "Проверяемый реквизит"; ОблШ.Область(1,10).Текст = "Текущее значение"; ОблШ.Область(1,11).Текст = "Рекомендация";
	Для Инд = 1 По 11 Цикл ОблШ.Область(1, Инд).Шрифт = Новый Шрифт(, , Истина); КонецЦикла;
	Для Каждого С Из ТЗ Цикл
		ОблС = ТД.Области.Добавить(); ОблС.Область(1,1).Текст = Строка(С.Ссылка); ОблС.Область(1,2).Текст = С.Код;
		ОблС.Область(1,3).Текст = С.Наименование; ОблС.Область(1,4).Текст = Строка(С.Родитель);
		ОблС.Область(1,5).Текст = С.КодПроблемы; ОблС.Область(1,6).Текст = С.Проблема;
		ОблС.Область(1,7).Текст = С.Критичность; ОблС.Область(1,8).Текст = С.Вес;
		ОблС.Область(1,9).Текст = С.ПроверяемыйРеквизит; ОблС.Область(1,10).Текст = С.ТекущееЗначение; ОблС.Область(1,11).Текст = С.Рекомендация;
	КонецЦикла;
	ТД.НоваяСтраница();
	ОблП = ТД.Области.Добавить(); ОблП.Объединить(1,1,1,2); ОблП.Текст = "Параметры"; ОблП.Шрифт = Новый Шрифт(, , Истина);
	ТД.Область(2,1).Текст = "Проверено"; ТД.Область(2,2).Текст = Строка(Проверено);
	ТД.Область(3,1).Текст = "С проблемами"; ТД.Область(3,2).Текст = Строка(СПроблемами);
	ТД.Область(4,1).Текст = "Проблем"; ТД.Область(4,2).Текст = Строка(Проблем);
	ТД.Область(5,1).Текст = "Строк всего"; ТД.Область(5,2).Текст = Строка(СтрокПолн);
	ТД.Область(6,1).Текст = "Строк отображается"; ТД.Область(6,2).Текст = Строка(СтрокОтобр);
	ТД.НоваяСтраница();
	Свод = ПостроитьСводку(ТЗ, Проверено);
	ОблЗ2 = ТД.Области.Добавить(); ОблЗ2.Объединить(1,1,1,6); ОблЗ2.Текст = "Сводка"; ОблЗ2.Шрифт = Новый Шрифт(, , Истина);
	ОблШ2 = ТД.Области.Добавить();
	ОблШ2.Область(1,1).Текст = "Код"; ОблШ2.Область(1,2).Текст = "Проблема"; ОблШ2.Область(1,3).Текст = "Критичность";
	ОблШ2.Область(1,4).Текст = "Карточек"; ОблШ2.Область(1,5).Текст = "Проблем"; ОблШ2.Область(1,6).Текст = "Доля, %";
	Для Инд2 = 1 По 6 Цикл ОблШ2.Область(1, Инд2).Шрифт = Новый Шрифт(, , Истина); КонецЦикла;
	Для Каждого Св Из Свод Цикл
		ОблСв = ТД.Области.Добавить(); ОблСв.Область(1,1).Текст = Св.КодПроблемы; ОблСв.Область(1,2).Текст = Св.Проблема;
		ОблСв.Область(1,3).Текст = Св.Критичность; ОблСв.Область(1,4).Текст = Св.Карточек; ОблСв.Область(1,5).Текст = Св.Проблем; ОблСв.Область(1,6).Текст = Св.Доля;
	КонецЦикла;
	ТД.Записать(ПутьКФайлу, ТипФайлаТабличногоДокумента.XLSX);
КонецПроцедуры


