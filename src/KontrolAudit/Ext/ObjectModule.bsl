#Область ПрограммныйИнтерфейс

#КонецОбласти

#Область ТекстыЗапросов

Функция НормализоватьЛимит(МаксСтрок) Экспорт
	Если МаксСтрок = Неопределено Тогда
		МаксСтрок = 1000;
	КонецЕсли;
	МаксСтрок = Цел(МаксСтрок);
	Если МаксСтрок < 1 Тогда
		МаксСтрок = 1;
	КонецЕсли;
	Если МаксСтрок > 100000 Тогда
		МаксСтрок = 100000;
	КонецЕсли;
	Возврат МаксСтрок;
КонецФункции

Функция ПостроитьОсновнойЗапрос(УчитыватьПомеченные, УчитыватьГруппы, МаксСтрок) Экспорт
	Лимит = НормализоватьЛимит(МаксСтрок);
	ТекстЛимита = Формат(Лимит, "ЧГ=0");
	Текст = "ВЫБРАТЬ ПЕРВЫЕ " + ТекстЛимита + "
	|	Номенклатура.Ссылка           КАК Ссылка,
	|	Номенклатура.Код              КАК Код,
	|	Номенклатура.Наименование     КАК Наименование,
	|	Номенклатура.Родитель         КАК Родитель,
	|	Номенклатура.ЭтоГруппа        КАК ЭтоГруппа,
	|	Номенклатура.ПометкаУдаления  КАК ПометкаУдаления,
	|	Номенклатура.Артикул          КАК Артикул,
	|	Номенклатура.ВидНоменклатуры  КАК ВидНоменклатуры,
	|	Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Номенклатура.СтавкаНДС        КАК СтавкаНДС,
	|	Номенклатура.ТоварнаяКатегория КАК ТоварнаяКатегория,
	|	Номенклатура.ГруппаФинансовогоУчета КАК ГруппаФинансовогоУчета,
	|	Номенклатура.ТипНоменклатуры  КАК ТипНоменклатуры,
	|	Номенклатура.НаименованиеПолное КАК НаименованиеПолное,
	|	Номенклатура.Производитель    КАК Производитель,
	|	Номенклатура.ЦеноваяГруппа    КАК ЦеноваяГруппа,
	|	Номенклатура.КодДляПоиска     КАК КодДляПоиска
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	1=1";
	Если НЕ УчитыватьГруппы Тогда
		Текст = Текст + "
		|	И Номенклатура.ЭтоГруппа = ЛОЖЬ";
	КонецЕсли;
	Если НЕ УчитыватьПомеченные Тогда
		Текст = Текст + "
		|	И НЕ Номенклатура.ПометкаУдаления";
	КонецЕсли;
	Текст = Текст + "
	|УПОРЯДОЧИТЬ ПО
	|	Номенклатура.Наименование";
	Возврат Текст;
КонецФункции

Функция ТекстЗапросаДублейНаименований(УчитыватьПомеченные, УчитыватьГруппы) Экспорт
	Текст = "ВЫБРАТЬ
	|	Номенклатура.Наименование КАК Наименование,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Номенклатура.Ссылка) КАК КоличествоДублей
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Наименование <> " + "";
	Если НЕ УчитыватьГруппы Тогда
		Текст = Текст + "
		|	И НЕ Номенклатура.ЭтоГруппа";
	КонецЕсли;
	Если НЕ УчитыватьПомеченные Тогда
		Текст = Текст + "
		|	И НЕ Номенклатура.ПометкаУдаления";
	КонецЕсли;
	Текст = Текст + "
	|СГРУППИРОВАТЬ ПО
	|	Номенклатура.Наименование
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Номенклатура.Ссылка) > 1";
	Возврат Текст;
КонецФункции

Функция ТекстЗапросаДублейКодов(УчитыватьПомеченные, УчитыватьГруппы) Экспорт
	Текст = "ВЫБРАТЬ
	|	Номенклатура.Код КАК Код,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Номенклатура.Ссылка) КАК КоличествоДублей
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Код <> " + "";
	Если НЕ УчитыватьГруппы Тогда
		Текст = Текст + "
		|	И НЕ Номенклатура.ЭтоГруппа";
	КонецЕсли;
	Если НЕ УчитыватьПомеченные Тогда
		Текст = Текст + "
		|	И НЕ Номенклатура.ПометкаУдаления";
	КонецЕсли;
	Текст = Текст + "
	|СГРУППИРОВАТЬ ПО
	|	Номенклатура.Код
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Номенклатура.Ссылка) > 1";
	Возврат Текст;
КонецФункции

#КонецОбласти

#Область ОбработкаРезультатов

Функция СоздатьТаблицуРезультата() Экспорт
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Ссылка",             Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТЗ.Колонки.Добавить("Код",                Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("Наименование",        Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("Родитель",            Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТЗ.Колонки.Добавить("Проблема",            Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("ПроверяемыйРеквизит", Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("ТекущееЗначение",     Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("Рекомендация",        Новый ОписаниеТипов("Строка"));
	Возврат ТЗ;
КонецФункции

Процедура ДобавитьПроблему(ТЗ, Данные, Проблема, Реквизит, Значение, Совет) Экспорт
	Стр = ТЗ.Добавить();
	Стр.Ссылка             = Данные.Ссылка;
	Стр.Код                = Данные.Код;
	Стр.Наименование       = Данные.Наименование;
	Стр.Родитель           = Данные.Родитель;
	Стр.Проблема           = Проблема;
	Стр.ПроверяемыйРеквизит = Реквизит;
	Стр.ТекущееЗначение    = Значение;
	Стр.Рекомендация       = Совет;
КонецПроцедуры

Процедура ДобавитьСтрокуБезПроблем(ТЗ, Данные) Экспорт
	Стр = ТЗ.Добавить();
	Стр.Ссылка             = Данные.Ссылка;
	Стр.Код                = Данные.Код;
	Стр.Наименование       = Данные.Наименование;
	Стр.Родитель           = Данные.Родитель;
	Стр.Проблема           = "Проблем не обнаружено";
	Стр.ПроверяемыйРеквизит = "";
	Стр.ТекущееЗначение    = "";
	Стр.Рекомендация       = "";
КонецПроцедуры

Процедура ВыполнитьПроверкиГруппы(Данные, ТЗ, ДуплиНаим, ДуплиКодов) Экспорт
	Если НЕ ЗначениеЗаполнено(Данные.Наименование) Тогда
		ДобавитьПроблему(ТЗ, Данные, "Пустое наименование", "Наименование", "", "Заполните наименование группы.");
	КонецЕсли;
	Если Данные.ПометкаУдаления Тогда
		ДобавитьПроблему(ТЗ, Данные, "Группа помечена на удаление", "ПометкаУдаления", "Да", "Снимите пометку удаления.");
	КонецЕсли;
	Если ДуплиНаим <> Неопределено Тогда
		СтрДубля = ДуплиНаим.Найти(Данные.Наименование, "Наименование");
		Если СтрДубля <> Неопределено Тогда
			ДобавитьПроблему(ТЗ, Данные, "Дубликат наименования (ещё " + (СтрДубля.КоличествоДублей - 1) + " шт.)", "Наименование", Данные.Наименование, "Проверьте группы с одинаковым наименованием.");
		КонецЕсли;
	КонецЕсли;
	Если ДуплиКодов <> Неопределено И ЗначениеЗаполнено(Данные.Код) Тогда
		СтрДубляК = ДуплиКодов.Найти(Данные.Код, "Код");
		Если СтрДубляК <> Неопределено Тогда
			ДобавитьПроблему(ТЗ, Данные, "Дубликат кода (ещё " + (СтрДубляК.КоличествоДублей - 1) + " шт.)", "Код", Данные.Код, "Проверьте группы с одинаковым кодом.");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура ВыполнитьПроверкиЭлемента(Данные, ТЗ, ДуплиНаим, ДуплиКодов) Экспорт
	Если Данные.ПометкаУдаления Тогда
		ДобавитьПроблему(ТЗ, Данные, "Элемент помечен на удаление", "ПометкаУдаления", "Да", "Снимите пометку удаления.");
	КонецЕсли;
	Если ДуплиНаим <> Неопределено Тогда
		СтрДубля = ДуплиНаим.Найти(Данные.Наименование, "Наименование");
		Если СтрДубля <> Неопределено Тогда
			ДобавитьПроблему(ТЗ, Данные, "Дубликат наименования (ещё " + (СтрДубля.КоличествоДублей - 1) + " шт.)", "Наименование", Данные.Наименование, "Проверьте элементы с одинаковым наименованием.");
		КонецЕсли;
	КонецЕсли;
	Если ДуплиКодов <> Неопределено И ЗначениеЗаполнено(Данные.Код) Тогда
		СтрДубляК = ДуплиКодов.Найти(Данные.Код, "Код");
		Если СтрДубляК <> Неопределено Тогда
			ДобавитьПроблему(ТЗ, Данные, "Дубликат кода (ещё " + (СтрДубляК.КоличествоДублей - 1) + " шт.)", "Код", Данные.Код, "Проверьте элементы с одинаковым кодом.");
		КонецЕсли;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Данные.Родитель) Тогда
		ДобавитьПроблему(ТЗ, Данные, "Элемент вне группы", "Родитель", "", "Переместите в группу.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Данные.Артикул) Тогда
		ДобавитьПроблему(ТЗ, Данные, "Не заполнен артикул", "Артикул", "", "Укажите артикул.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Данные.ВидНоменклатуры) Тогда
		ДобавитьПроблему(ТЗ, Данные, "Не заполнен вид номенклатуры", "ВидНоменклатуры", "", "Выберите вид номенклатуры.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Данные.ЕдиницаИзмерения) Тогда
		ДобавитьПроблему(ТЗ, Данные, "Не заполнена единица хранения", "ЕдиницаИзмерения", "", "Выберите единицу хранения.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Данные.СтавкаНДС) Тогда
		ДобавитьПроблему(ТЗ, Данные, "Не заполнена ставка НДС", "СтавкаНДС", "", "Выберите ставку НДС.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Данные.ТоварнаяКатегория) Тогда
		ДобавитьПроблему(ТЗ, Данные, "Не заполнена товарная категория", "ТоварнаяКатегория", "", "Выберите товарную категорию.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Данные.ГруппаФинансовогоУчета) Тогда
		ДобавитьПроблему(ТЗ, Данные, "Не заполнена группа фин. учёта", "ГруппаФинансовогоУчета", "", "Выберите группу.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Данные.ТипНоменклатуры) Тогда
		ДобавитьПроблему(ТЗ, Данные, "Не заполнен тип номенклатуры", "ТипНоменклатуры", "", "Проверьте ВидНоменклатуры.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Данные.НаименованиеПолное) Тогда
		ДобавитьПроблему(ТЗ, Данные, "Не заполнено наименование для печати", "НаименованиеПолное", "", "Заполните полное наименование.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Данные.КодДляПоиска) Тогда
		ДобавитьПроблему(ТЗ, Данные, "Не заполнен код для поиска", "КодДляПоиска", "", "Заполните код для поиска.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Данные.Производитель) Тогда
		ДобавитьПроблему(ТЗ, Данные, "Не заполнен производитель", "Производитель", "", "Выберите производителя.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Данные.ЦеноваяГруппа) Тогда
		ДобавитьПроблему(ТЗ, Данные, "Не заполнена ценовая группа", "ЦеноваяГруппа", "", "Выберите ценовую группу.");
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ФормированиеОтчета

Функция ВыполнитьЗапросДублей(ТекстЗапроса, Диагностика) Экспорт
	Результат = Неопределено;
	Попытка
		Запрос = Новый Запрос(ТекстЗапроса);
		Результат = Запрос.Выполнить().Выгрузить();
	Исключение
		Диагностика = Диагностика + "Ошибка запроса дублей: " + ОписаниеОшибки() + Символы.ПС;
		Диагностика = Диагностика + "Текст: " + ТекстЗапроса + Символы.ПС;
	КонецПопытки;
	Возврат Результат;
КонецФункции

Процедура СформироватьОтчет(РезультатТЗ, Настройки, ТехОшибка, Проверено, СПроблемами, Проблем, СтрокРез, Отказ) Экспорт
	Попытка
		РезультатТЗ.Очистить();
		ТехОшибка = "";
		Проверено = 0;
		СПроблемами = 0;
		Проблем = 0;
		СтрокРез = 0;
		Диагностика = "";
		МаксСтрок = НормализоватьЛимит(Настройки.МаксимумКарточек);
		ТекстОсновной = ПостроитьОсновнойЗапрос(Настройки.УчитыватьПомеченныеНаУдаление, Настройки.УчитыватьГруппы, МаксСтрок);
		Диагностика = Диагностика + "Параметры: Помеченные=" + Настройки.УчитыватьПомеченныеНаУдаление + " Группы=" + Настройки.УчитыватьГруппы + " Проблемы=" + Настройки.ТолькоСПроблемами + " Лимит=" + МаксСтрок + Символы.ПС;
		Диагностика = Диагностика + "Основной запрос:" + Символы.ПС + ТекстОсновной + Символы.ПС;
		ДуплиНаим = ВыполнитьЗапросДублей(ТекстЗапросаДублейНаименований(Настройки.УчитыватьПомеченныеНаУдаление, Настройки.УчитыватьГруппы), Диагностика);
		ДуплиКодов = ВыполнитьЗапросДублей(ТекстЗапросаДублейКодов(Настройки.УчитыватьПомеченныеНаУдаление, Настройки.УчитыватьГруппы), Диагностика);
		Запрос = Новый Запрос(ТекстОсновной);
		Выборка = Запрос.Выполнить().Выбрать();
		ТЗ = СоздатьТаблицуРезультата();
		Пока Выборка.Следующий() Цикл
			Данные = Новый Структура;
			Данные.Вставить("Ссылка", Выборка.Ссылка);
			Данные.Вставить("Код", Выборка.Код);
			Данные.Вставить("Наименование", Выборка.Наименование);
			Данные.Вставить("Родитель", Выборка.Родитель);
			Данные.Вставить("ЭтоГруппа", Выборка.ЭтоГруппа);
			Данные.Вставить("ПометкаУдаления", Выборка.ПометкаУдаления);
			Данные.Вставить("Артикул", Выборка.Артикул);
			Данные.Вставить("ВидНоменклатуры", Выборка.ВидНоменклатуры);
			Данные.Вставить("ЕдиницаИзмерения", Выборка.ЕдиницаИзмерения);
			Данные.Вставить("СтавкаНДС", Выборка.СтавкаНДС);
			Данные.Вставить("ТоварнаяКатегория", Выборка.ТоварнаяКатегория);
			Данные.Вставить("ГруппаФинансовогоУчета", Выборка.ГруппаФинансовогоУчета);
			Данные.Вставить("ТипНоменклатуры", Выборка.ТипНоменклатуры);
			Данные.Вставить("НаименованиеПолное", Выборка.НаименованиеПолное);
			Данные.Вставить("Производитель", Выборка.Производитель);
			Данные.Вставить("ЦеноваяГруппа", Выборка.ЦеноваяГруппа);
			Данные.Вставить("КодДляПоиска", Выборка.КодДляПоиска);
			Проверено = Проверено + 1;
			Если Данные.ЭтоГруппа Тогда
				ВыполнитьПроверкиГруппы(Данные, ТЗ, ДуплиНаим, ДуплиКодов);
			Иначе
				ВыполнитьПроверкиЭлемента(Данные, ТЗ, ДуплиНаим, ДуплиКодов);
			КонецЕсли;
		КонецЦикла;
		Если Настройки.ТолькоСПроблемами Тогда
			ТЗОтф = СоздатьТаблицуРезультата();
			Для Каждого Стр Из ТЗ Цикл
				Если Стр.Проблема <> "Проблем не обнаружено" Тогда
					НС = ТЗОтф.Добавить();
					ЗаполнитьЗначенияСвойств(НС, Стр);
				КонецЕсли;
			КонецЦикла;
			ТЗ = ТЗОтф;
		Иначе
			// Добавляем строки без проблем для карточек без дефектов
			// (карточки уже проверены, если нет проблем — не попали в ТЗ)
			// Проходим повторно по выборке и добавляем "без проблем" для чистых
			Выборка2 = Запрос.Выполнить().Выбрать();
			Пока Выборка2.Следующий() Цикл
				УжеЕсть = Ложь;
				Для Каждого Стр Из ТЗ Цикл
					Если Стр.Ссылка = Выборка2.Ссылка И Стр.Проблема <> "Проблем не обнаружено" Тогда
						УжеЕсть = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Если НЕ УжеЕсть Тогда
					Д = Новый Структура;
					Д.Вставить("Ссылка", Выборка2.Ссылка);
					Д.Вставить("Код", Выборка2.Код);
					Д.Вставить("Наименование", Выборка2.Наименование);
					Д.Вставить("Родитель", Выборка2.Родитель);
					ДобавитьСтрокуБезПроблем(ТЗ, Д);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		СтрокРез = ТЗ.Количество();
		Уник = Новый Соответствие;
		Для Каждого Стр Из ТЗ Цикл
			Если Стр.Проблема <> "Проблем не обнаружено" Тогда
				Ключ = Строка(Стр.Ссылка);
				Если Уник[Ключ] = Неопределено Тогда
					Уник.Вставить(Ключ, Истина);
					СПроблемами = СПроблемами + 1;
				КонецЕсли;
				Проблем = Проблем + 1;
			КонецЕсли;
		КонецЦикла;
		Для Каждого Стр Из ТЗ Цикл
			НС = РезультатТЗ.Добавить();
			ЗаполнитьЗначенияСвойств(НС, Стр);
		КонецЦикла;
		ТехОшибка = "Выполнено успешно." + Символы.ПС + Диагностика;
	Исключение
		Отказ = Истина;
		ТехОшибка = "Ошибка: " + ОписаниеОшибки() + Символы.ПС + Диагностика;
	КонецПопытки;
КонецПроцедуры

#КонецОбласти
