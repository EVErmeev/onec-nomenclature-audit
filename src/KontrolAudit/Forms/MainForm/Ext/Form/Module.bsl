&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	УчитыватьПомеченныеНаУдаление = Ложь; УчитыватьГруппы = Ложь; ТолькоСПроблемами = Истина; МаксимумКарточек = 1000;
	СтатусФормирования = ""; ТехническаяОшибка = ""; СтрокПолногоРезультата = 0; СтрокОтображается = 0;
	ПровереноКарточек = 0; КарточекСПроблемами = 0; НайденоПроблем = 0; ЕстьОшибка = Ложь;
	ФильтрКритичность = ""; ФильтрКодПроблемы = ""; ФильтрПроблема = ""; ФильтрГруппа = Неопределено;
	Элементы.ТехническаяОшибка.Видимость = Ложь;
	ЗагрузитьНастройки();
	ОтчетОбъект = РеквизитФормыВЗначение("Объект");
	Если ОтчетОбъект <> Неопределено Тогда
		Флаги = ОтчетОбъект.ПолучитьФункциональныеФлаги();
		Элементы.ЭкспортироватьCSV.Видимость = Флаги.Экспорт;
		Элементы.ЭкспортироватьXLSX.Видимость = Флаги.Экспорт;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНастройки()
	Попытка УчитыватьПомеченныеНаУдаление = ВосстановитьЗначение("KKA_Помеченные", Ложь); Исключение КонецПопытки;
	Попытка УчитыватьГруппы = ВосстановитьЗначение("KKA_Группы", Ложь); Исключение КонецПопытки;
	Попытка ТолькоСПроблемами = ВосстановитьЗначение("KKA_Проблемы", Истина); Исключение КонецПопытки;
	Попытка МаксимумКарточек = ВосстановитьЗначение("KKA_Лимит", 1000); Исключение КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройки()
	СохранитьЗначение("KKA_Помеченные", УчитыватьПомеченныеНаУдаление);
	СохранитьЗначение("KKA_Группы", УчитыватьГруппы);
	СохранитьЗначение("KKA_Проблемы", ТолькоСПроблемами);
	СохранитьЗначение("KKA_Лимит", МаксимумКарточек);
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда) СформироватьНаСервере(); КонецПроцедуры

&НаКлиенте
Процедура СброситьФильтры(Команда) СброситьФильтрыНаСервере(); КонецПроцедуры

&НаКлиенте
Процедура СброситьНастройки(Команда) СброситьНастройкиНаСервере(); КонецПроцедуры

&НаКлиенте
Процедура ЭкспортироватьCSV(Команда) ЭкспортироватьCSVНаСервере(); КонецПроцедуры

&НаКлиенте
Процедура ЭкспортироватьXLSX(Команда) ЭкспортироватьXLSXНаСервере(); КонецПроцедуры

&НаКлиенте
Процедура ФильтрПриИзменении(Элемент) ПрименитьФильтрНаСервере(); КонецПроцедуры

&НаСервере
Процедура СброситьНастройкиНаСервере()
	УчитыватьПомеченныеНаУдаление = Ложь; УчитыватьГруппы = Ложь; ТолькоСПроблемами = Истина; МаксимумКарточек = 1000;
	СохранитьНастройки(); СтатусФормирования = "Настройки сброшены";
КонецПроцедуры

&НаСервере
Процедура СброситьФильтрыНаСервере()
	ФильтрКритичность = ""; ФильтрКодПроблемы = ""; ФильтрПроблема = ""; ФильтрГруппа = Неопределено;
	ВосстановитьРезультатИзПолнойКопии();
КонецПроцедуры

&НаСервере
Процедура ВосстановитьРезультатИзПолнойКопии()
	Результат.Очистить(); СтрокОтображается = 0;
	Для Каждого С Из ПолныйРезультат Цикл НР=Результат.Добавить(); ЗаполнитьЗначенияСвойств(НР,С); КонецЦикла;
	СтрокОтображается = Результат.Количество();
КонецПроцедуры

&НаСервере
Процедура ПрименитьФильтрНаСервере()
	Если НЕ ЗначениеЗаполнено(ФильтрКритичность) И НЕ ЗначениеЗаполнено(ФильтрКодПроблемы) И НЕ ЗначениеЗаполнено(ФильтрПроблема) И ФильтрГруппа = Неопределено Тогда
		ВосстановитьРезультатИзПолнойКопии();
	Иначе
		ОтчетОбъект = РеквизитФормыВЗначение("Объект"); Если ОтчетОбъект = Неопределено Тогда Возврат; КонецЕсли;
		СтрГруппы = ?(ФильтрГруппа <> Неопределено, Строка(ФильтрГруппа), "");
		Отф = ОтчетОбъект.ПрименитьФильтры(ПолныйРезультат, ФильтрКритичность, ФильтрКодПроблемы, ФильтрПроблема, СтрГруппы);
		Результат.Очистить(); СтрокОтображается = 0;
		Для Каждого С Из Отф Цикл НР=Результат.Добавить(); ЗаполнитьЗначенияСвойств(НР,С); КонецЦикла;
		СтрокОтображается = Результат.Количество();
		СводкаОб = ОтчетОбъект.ПостроитьСводку(Результат, ПровереноКарточек);
		Сводка.Очистить(); Для Каждого С Из СводкаОб Цикл НР=Сводка.Добавить(); ЗаполнитьЗначенияСвойств(НР,С); КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()
	Настройки = Новый Структура; Настройки.Вставить("УчитыватьПомеченныеНаУдаление", УчитыватьПомеченныеНаУдаление);
	Настройки.Вставить("УчитыватьГруппы", УчитыватьГруппы); Настройки.Вставить("ТолькоСПроблемами", ТолькоСПроблемами);
	Настройки.Вставить("МаксимумКарточек", МаксимумКарточек);
	СохранитьНастройки(); Отказ = Ложь; ОтчетОбъект = РеквизитФормыВЗначение("Объект");
	Если ОтчетОбъект <> Неопределено Тогда
		ОтчетОбъект.СформироватьОтчет(Результат, Настройки, СтатусФормирования, ТехническаяОшибка, ПровереноКарточек, КарточекСПроблемами, НайденоПроблем, СтрокПолногоРезультата, ЕстьОшибка, Отказ);
		Если ЕстьОшибка Тогда Элементы.ТехническаяОшибка.Видимость = Истина;
		Иначе
			Элементы.ТехническаяОшибка.Видимость = Ложь; СтрокОтображается = СтрокПолногоРезультата;
			ПолныйРезультат.Очистить(); Для Каждого С Из Результат Цикл НР=ПолныйРезультат.Добавить(); ЗаполнитьЗначенияСвойств(НР,С); КонецЦикла;
			СводкаОб = ОтчетОбъект.ПостроитьСводку(Результат, ПровереноКарточек);
			Сводка.Очистить(); Для Каждого С Из СводкаОб Цикл НР=Сводка.Добавить(); ЗаполнитьЗначенияСвойств(НР,С); КонецЦикла;
		КонецЕсли;
	Иначе ТехническаяОшибка = "Объект не найден."; ЕстьОшибка = Истина; Элементы.ТехническаяОшибка.Видимость = Истина;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЭкспортироватьCSVНаСервере()
	ОтчетОбъект = РеквизитФормыВЗначение("Объект"); Если ОтчетОбъект = Неопределено Тогда Возврат; КонецЕсли;
	Настройки = Новый Структура; Настройки.Вставить("УчитыватьПомеченныеНаУдаление", УчитыватьПомеченныеНаУдаление);
	Настройки.Вставить("УчитыватьГруппы", УчитыватьГруппы); Настройки.Вставить("ТолькоСПроблемами", ТолькоСПроблемами);
	Настройки.Вставить("МаксимумКарточек", МаксимумКарточек);
	Имя = "КонтрольНСИ_" + Формат(ТекущаяДата(), "ДФ=yyyyMMdd_HHmmss") + ".csv";
	ОтчетОбъект.ЭкспортироватьCSV(Результат, КаталогВременныхФайлов() + Имя, Настройки, ПровереноКарточек, КарточекСПроблемами, НайденоПроблем, СтрокПолногоРезультата, СтрокОтображается);
	СтатусФормирования = "CSV сохранён: " + КаталогВременныхФайлов() + Имя;
КонецПроцедуры

&НаСервере
Процедура ЭкспортироватьXLSXНаСервере()
	ОтчетОбъект = РеквизитФормыВЗначение("Объект"); Если ОтчетОбъект = Неопределено Тогда Возврат; КонецЕсли;
	Настройки = Новый Структура; Настройки.Вставить("УчитыватьПомеченныеНаУдаление", УчитыватьПомеченныеНаУдаление);
	Настройки.Вставить("УчитыватьГруппы", УчитыватьГруппы); Настройки.Вставить("ТолькоСПроблемами", ТолькоСПроблемами);
	Настройки.Вставить("МаксимумКарточек", МаксимумКарточек);
	Имя = "КонтрольНСИ_" + Формат(ТекущаяДата(), "ДФ=yyyyMMdd_HHmmss") + ".xlsx";
	ОтчетОбъект.ЭкспортироватьXLSX(Результат, КаталогВременныхФайлов() + Имя, Настройки, ПровереноКарточек, КарточекСПроблемами, НайденоПроблем, СтрокПолногоРезультата, СтрокОтображается, ФильтрКритичность, ФильтрКодПроблемы, ФильтрПроблема, ФильтрГруппа);
	СтатусФормирования = "XLSX сохранён: " + КаталогВременныхФайлов() + Имя;
КонецПроцедуры

&НаСервере
Процедура ФильтрКритичностьНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	Список = Новый СписокЗначений; Список.Добавить("Критическая"); Список.Добавить("Высокая"); Список.Добавить("Средняя"); Список.Добавить("Информационная");
	ДанныеВыбора.СписокВыбора = Список;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКодыНаСервере(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	Список = Новый СписокЗначений; ОтчетОбъект = РеквизитФормыВЗначение("Объект");
	Если ОтчетОбъект <> Неопределено Тогда Т = ОтчетОбъект.ПолучитьОписаниеВстроенныхПравил();
		Для Каждого П Из Т Цикл Если П.Код <> "NO_PROBLEMS" Тогда Список.Добавить(П.Код, П.Код + " - " + П.Наименование); КонецЕсли; КонецЦикла;
	КонецЕсли;
	ДанныеВыбора.СписокВыбора = Список;
КонецПроцедуры