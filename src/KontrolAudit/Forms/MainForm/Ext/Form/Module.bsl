&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	УчитыватьПомеченныеНаУдаление = Ложь; УчитыватьГруппы = Ложь; ТолькоСПроблемами = Истина; МаксимумКарточек = 1000;
	СтатусФормирования = ""; ТехническаяОшибка = ""; ПровереноКарточек = 0; КарточекСПроблемами = 0;
	НайденоПроблем = 0; СтрокРезультата = 0; ЕстьОшибка = Ложь; ФильтрКритичность = ""; ФильтрКодПроблемы = "";
	Элементы.ТехническаяОшибка.Видимость = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда) СформироватьНаСервере(); КонецПроцедуры

&НаКлиенте
Процедура СброситьФильтры(Команда) СброситьФильтрыНаСервере(); КонецПроцедуры

&НаКлиенте
Процедура ЭкспортироватьCSV(Команда) ЭкспортироватьCSVНаСервере(); КонецПроцедуры

&НаКлиенте
Процедура ФильтрПриИзменении(Элемент) ПрименитьФильтрНаСервере(); КонецПроцедуры

&НаСервере
Процедура СброситьФильтрыНаСервере()
	ФильтрКритичность = ""; ФильтрКодПроблемы = "";
	// Восстанавливаем результат из полной копии
	ВосстановитьРезультатИзПолнойКопии();
КонецПроцедуры

&НаСервере
Процедура ВосстановитьРезультатИзПолнойКопии()
	Результат.Очистить();
	Для Каждого С Из ПолныйРезультат Цикл НР=Результат.Добавить(); ЗаполнитьЗначенияСвойств(НР,С); КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПрименитьФильтрНаСервере()
	Если НЕ ЗначениеЗаполнено(ФильтрКритичность) И НЕ ЗначениеЗаполнено(ФильтрКодПроблемы) Тогда
		// Фильтр пуст — показываем всё
		ВосстановитьРезультатИзПолнойКопии();
	Иначе
		ОтчетОбъект = РеквизитФормыВЗначение("Объект");
		Если ОтчетОбъект = Неопределено Тогда Возврат; КонецЕсли;
		// Фильтруем ВСЕГДА от полной копии, а не от текущего Результат
		Отф = ОтчетОбъект.ПрименитьФильтры(ПолныйРезультат, ФильтрКритичность, ФильтрКодПроблемы);
		Результат.Очистить();
		Для Каждого С Из Отф Цикл НР=Результат.Добавить(); ЗаполнитьЗначенияСвойств(НР,С); КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()
	Настройки = Новый Структура;
	Настройки.Вставить("УчитыватьПомеченныеНаУдаление", УчитыватьПомеченныеНаУдаление);
	Настройки.Вставить("УчитыватьГруппы", УчитыватьГруппы);
	Настройки.Вставить("ТолькоСПроблемами", ТолькоСПроблемами);
	Настройки.Вставить("МаксимумКарточек", МаксимумКарточек);
	Отказ = Ложь;
	ОтчетОбъект = РеквизитФормыВЗначение("Объект");
	Если ОтчетОбъект <> Неопределено Тогда
		ОтчетОбъект.СформироватьОтчет(Результат, Настройки, СтатусФормирования, ТехническаяОшибка, ПровереноКарточек, КарточекСПроблемами, НайденоПроблем, СтрокРезультата, ЕстьОшибка, Отказ);
		Если ЕстьОшибка Тогда Элементы.ТехническаяОшибка.Видимость = Истина;
		Иначе
			Элементы.ТехническаяОшибка.Видимость = Ложь;
			// Сохраняем полную копию для фильтрации
			ПолныйРезультат.Очистить();
			Для Каждого С Из Результат Цикл НР=ПолныйРезультат.Добавить(); ЗаполнитьЗначенияСвойств(НР,С); КонецЦикла;
			// Сводка
			СводкаОб = ОтчетОбъект.ПостроитьСводку(Результат);
			Сводка.Очистить(); Для Каждого С Из СводкаОб Цикл НР=Сводка.Добавить(); ЗаполнитьЗначенияСвойств(НР,С); КонецЦикла;
		КонецЕсли;
	Иначе ТехническаяОшибка = "Объект отчёта не найден."; ЕстьОшибка = Истина; Элементы.ТехническаяОшибка.Видимость = Истина;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЭкспортироватьCSVНаСервере()
	ОтчетОбъект = РеквизитФормыВЗначение("Объект"); Если ОтчетОбъект = Неопределено Тогда Возврат; КонецЕсли;
	Настройки = Новый Структура;
	Настройки.Вставить("УчитыватьПомеченныеНаУдаление", УчитыватьПомеченныеНаУдаление);
	Настройки.Вставить("УчитыватьГруппы", УчитыватьГруппы);
	Настройки.Вставить("ТолькоСПроблемами", ТолькоСПроблемами);
	Настройки.Вставить("МаксимумКарточек", МаксимумКарточек);
	Имя = "КонтрольНСИ_" + Формат(ТекущаяДата(), "ДФ=yyyyMMdd_HHmmss") + ".csv";
	ОтчетОбъект.ЭкспортироватьCSV(Результат, КаталогВременныхФайлов() + Имя, Настройки, ПровереноКарточек, КарточекСПроблемами, НайденоПроблем, СтрокРезультата);
	СтатусФормирования = "CSV сохранён: " + КаталогВременныхФайлов() + Имя;
КонецПроцедуры

&НаСервере
Процедура ФильтрКритичностьНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	Список = Новый СписокЗначений; Список.Добавить("Критическая"); Список.Добавить("Высокая"); Список.Добавить("Средняя"); Список.Добавить("Информационная");
	ДанныеВыбора.СписокВыбора = Список;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКодыНаСервере(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	Список = Новый СписокЗначений;
	ОтчетОбъект = РеквизитФормыВЗначение("Объект");
	Если ОтчетОбъект <> Неопределено Тогда
		Т = ОтчетОбъект.ПолучитьОписаниеВстроенныхПравил();
		Для Каждого П Из Т Цикл Если П.Код <> "NO_PROBLEMS" Тогда Список.Добавить(П.Код, П.Код + " - " + П.Наименование); КонецЕсли; КонецЦикла;
	КонецЕсли;
	ДанныеВыбора.СписокВыбора = Список;
КонецПроцедуры