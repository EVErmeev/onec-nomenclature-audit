&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	УчитыватьПомеченныеНаУдаление = Ложь;
	УчитыватьГруппы = Ложь;
	ТолькоСПроблемами = Истина;
	МаксимумКарточек = 1000;
	СтатусФормирования = "";
	ТехническаяОшибка = "";
	ПровереноКарточек = 0;
	КарточекСПроблемами = 0;
	НайденоПроблем = 0;
	СтрокРезультата = 0;
	ЕстьОшибка = Ложь;
	ФильтрКритичность = "";
	ФильтрКодПроблемы = "";
	Элементы.ТехническаяОшибка.Видимость = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	СформироватьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СброситьФильтры(Команда)
	СброситьФильтрыНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ЭкспортироватьCSV(Команда)
	ЭкспортироватьCSVНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ФильтрПриИзменении(Элемент)
	ПрименитьФильтрНаСервере();
КонецПроцедуры

&НаСервере
Процедура СброситьФильтрыНаСервере()
	ФильтрКритичность = "";
	ФильтрКодПроблемы = "";
	ПрименитьФильтрНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПрименитьФильтрНаСервере()
	ОтчетОбъект = РеквизитФормыВЗначение("Объект");
	Если ОтчетОбъект = Неопределено Тогда Возврат; КонецЕсли;
	Отфильтрованный = ОтчетОбъект.ПрименитьФильтры(Результат, ФильтрКритичность, ФильтрКодПроблемы);
	Результат.Очистить();
	Для Каждого С Из Отфильтрованный Цикл
		НС = Результат.Добавить(); ЗаполнитьЗначенияСвойств(НС, С);
	КонецЦикла;
	СводкаОб = ОтчетОбъект.ПостроитьСводку(Результат);
	Сводка.Очистить();
	Для Каждого С Из СводкаОб Цикл
		НС = Сводка.Добавить(); ЗаполнитьЗначенияСвойств(НС, С);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()
	Настройки = Новый Структура;
	Настройки.Вставить("УчитыватьПомеченныеНаУдаление", УчитыватьПомеченныеНаУдаление);
	Настройки.Вставить("УчитыватьГруппы", УчитыватьГруппы);
	Настройки.Вставить("ТолькоСПроблемами", ТолькоСПроблемами);
	Настройки.Вставить("МаксимумКарточек", МаксимумКарточек);
	Отказ = Ложь;
	ОтчетОбъект = РеквизитФормыВЗначение("Объект");
	Если ОтчетОбъект <> Неопределено Тогда
		ОтчетОбъект.СформироватьОтчет(Результат, Настройки, СтатусФормирования, ТехническаяОшибка, ПровереноКарточек, КарточекСПроблемами, НайденоПроблем, СтрокРезультата, ЕстьОшибка, Отказ);
		Если ЕстьОшибка Тогда
			Элементы.ТехническаяОшибка.Видимость = Истина;
		Иначе
			Элементы.ТехническаяОшибка.Видимость = Ложь;
			СводкаОб = ОтчетОбъект.ПостроитьСводку(Результат);
			Сводка.Очистить();
			Для Каждого С Из СводкаОб Цикл
				НС = Сводка.Добавить(); ЗаполнитьЗначенияСвойств(НС, С);
			КонецЦикла;
		КонецЕсли;
	Иначе
		ТехническаяОшибка = "Объект отчёта не найден.";
		ЕстьОшибка = Истина;
		Элементы.ТехническаяОшибка.Видимость = Истина;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЭкспортироватьCSVНаСервере()
	ОтчетОбъект = РеквизитФормыВЗначение("Объект");
	Если ОтчетОбъект = Неопределено Тогда Возврат; КонецЕсли;
	Настройки = Новый Структура;
	Настройки.Вставить("УчитыватьПомеченныеНаУдаление", УчитыватьПомеченныеНаУдаление);
	Настройки.Вставить("УчитыватьГруппы", УчитыватьГруппы);
	Настройки.Вставить("ТолькоСПроблемами", ТолькоСПроблемами);
	Настройки.Вставить("МаксимумКарточек", МаксимумКарточек);
	ПутьВрем = ПолучитьИмяВременногоФайла("csv");
	ОтчетОбъект.ЭкспортироватьCSV(Результат, ПутьВрем, Настройки, ПровереноКарточек, КарточекСПроблемами, НайденоПроблем, СтрокРезультата);
	НачатьПомещениеФайла(Новый ОписаниеОповещения("ПослеЭкспортаCSV", ЭтаФорма), ПутьВрем, "КонтрольНСИ.csv", Истина);
КонецПроцедуры

