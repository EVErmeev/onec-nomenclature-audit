&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	УчитыватьПомеченныеНаУдаление = Ложь;
	УчитыватьГруппы = Ложь;
	ТолькоСПроблемами = Истина;
	МаксимумКарточек = 1000;
	СтатусФормирования = "";
	ТехническаяОшибка = "";
	ПровереноКарточек = 0;
	КарточекСПроблемами = 0;
	НайденоПроблем = 0;
	СтрокРезультата = 0;
	ЕстьОшибка = Ложь;
	ФильтрКритичность = "";
	ФильтрКодПроблемы = "";
	Элементы.ТехническаяОшибка.Видимость = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	СформироватьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СброситьФильтры(Команда)
	СброситьФильтрыНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ЭкспортироватьCSV(Команда)
	ЭкспортироватьCSVНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ФильтрПриИзменении(Элемент)
	ПрименитьФильтрНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ФильтрКритичностьНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Список = Новый СписокЗначений;
	Список.Добавить("Критическая"); Список.Добавить("Высокая");
	Список.Добавить("Средняя"); Список.Добавить("Информационная");
	ПоказатьВыборЗначения(Новый ОписаниеОповещения("КритичностьВыбрана", ЭтаФорма), Список, "Выберите критичность", , , Элемент);
КонецПроцедуры

&НаКлиенте
Процедура КритичностьВыбрана(Выбранное, ДопПараметры) Экспорт
	Если Выбранное <> Неопределено Тогда ФильтрКритичность = Выбранное; ПрименитьФильтрНаСервере(); КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКодыНаСервере(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	Список = Новый СписокЗначений;
	ОтчетОбъект = РеквизитФормыВЗначение("Объект");
	Если ОтчетОбъект <> Неопределено Тогда
		Т = ОтчетОбъект.ПолучитьОписаниеВстроенныхПравил();
		Для Каждого П Из Т Цикл
			Если П.Код <> "NO_PROBLEMS" Тогда Список.Добавить(П.Код, П.Код + " - " + П.Наименование); КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	ПоказатьВыборЗначения(Новый ОписаниеОповещения("КодПроблемыВыбран", ЭтаФорма), Список, "Выберите код проблемы", , , Элемент);
КонецПроцедуры

&НаКлиенте
Процедура КодПроблемыВыбран(Выбранное, ДопПараметры) Экспорт
	Если Выбранное <> Неопределено Тогда ФильтрКодПроблемы = Выбранное; ПрименитьФильтрНаСервере(); КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура СброситьФильтрыНаСервере()
	ФильтрКритичность = "";
	ФильтрКодПроблемы = "";
	ПрименитьФильтрНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПрименитьФильтрНаСервере()
	ОтчетОбъект = РеквизитФормыВЗначение("Объект");
	Если ОтчетОбъект = Неопределено Тогда Возврат; КонецЕсли;
	Отф = ОтчетОбъект.ПрименитьФильтры(Результат, ФильтрКритичность, ФильтрКодПроблемы);
	Результат.Очистить();
	Для Каждого С Из Отф Цикл НР = Результат.Добавить(); ЗаполнитьЗначенияСвойств(НР, С); КонецЦикла;
	СводкаОб = ОтчетОбъект.ПостроитьСводку(Результат);
	Сводка.Очистить();
	Для Каждого С Из СводкаОб Цикл НР = Сводка.Добавить(); ЗаполнитьЗначенияСвойств(НР, С); КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()
	Настройки = Новый Структура;
	Настройки.Вставить("УчитыватьПомеченныеНаУдаление", УчитыватьПомеченныеНаУдаление);
	Настройки.Вставить("УчитыватьГруппы", УчитыватьГруппы);
	Настройки.Вставить("ТолькоСПроблемами", ТолькоСПроблемами);
	Настройки.Вставить("МаксимумКарточек", МаксимумКарточек);
	Отказ = Ложь;
	ОтчетОбъект = РеквизитФормыВЗначение("Объект");
	Если ОтчетОбъект <> Неопределено Тогда
		ОтчетОбъект.СформироватьОтчет(Результат, Настройки, СтатусФормирования, ТехническаяОшибка, ПровереноКарточек, КарточекСПроблемами, НайденоПроблем, СтрокРезультата, ЕстьОшибка, Отказ);
		Если ЕстьОшибка Тогда Элементы.ТехническаяОшибка.Видимость = Истина;
		Иначе
			Элементы.ТехническаяОшибка.Видимость = Ложь;
			СводкаОб = ОтчетОбъект.ПостроитьСводку(Результат);
			Сводка.Очистить();
			Для Каждого С Из СводкаОб Цикл НР = Сводка.Добавить(); ЗаполнитьЗначенияСвойств(НР, С); КонецЦикла;
		КонецЕсли;
	Иначе
		ТехническаяОшибка = "Объект отчёта не найден."; ЕстьОшибка = Истина; Элементы.ТехническаяОшибка.Видимость = Истина;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЭкспортироватьCSVНаСервере()
	ОтчетОбъект = РеквизитФормыВЗначение("Объект");
	Если ОтчетОбъект = Неопределено Тогда Возврат; КонецЕсли;
	Настройки = Новый Структура;
	Настройки.Вставить("УчитыватьПомеченныеНаУдаление", УчитыватьПомеченныеНаУдаление);
	Настройки.Вставить("УчитыватьГруппы", УчитыватьГруппы);
	Настройки.Вставить("ТолькоСПроблемами", ТолькоСПроблемами);
	Настройки.Вставить("МаксимумКарточек", МаксимумКарточек);
	Имя = "КонтрольНСИ_" + Формат(ТекущаяДата(), "ДФ=yyyyMMdd_HHmmss") + ".csv";
	Путь = КаталогВременныхФайлов() + Имя;
	ОтчетОбъект.ЭкспортироватьCSV(Результат, Путь, Настройки, ПровереноКарточек, КарточекСПроблемами, НайденоПроблем, СтрокРезультата);
	СтатусФормирования = "CSV сохранён: " + Путь;
КонецПроцедуры