&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПодключитьОбработчикОжидания("ВыполнитьИЗакрыть", 0.1, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьИЗакрыть()
	ВыполнитьТестНаСервере();
КонецПроцедуры

&НаСервере
Процедура ВыполнитьТестНаСервере()
	ПутьКConfig = "D:\OpenCode\onec-nomenclature-audit\temp\runtime-test\config.json";
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.ОткрытьФайл(ПутьКConfig);
	Config = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();

	ОтчетОбъект = РеквизитФормыВЗначение("Объект");
	ОтчетОбъект.ВыполнитьТест(
		Config.erfPath,
		Config.outputPath,
		Config.settings.УчитыватьПомеченныеНаУдаление,
		Config.settings.УчитыватьГруппы,
		Config.settings.ТолькоСПроблемами,
		Config.settings.МаксимумКарточек,
		Config.testId);

	ЗавершитьРаботуСистемы();
КонецПроцедуры
