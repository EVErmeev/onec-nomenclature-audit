	Настройки.Вставить("МаксимумКарточек", МаксимумКарточек);
	Отказ = Ложь;
	ОтчетОбъект = РеквизитФормыВЗначение("Объект");
	Если ОтчетОбъект <> Неопределено Тогда
		ОтчетОбъект.СформироватьОтчет(Результат, Настройки, СтатусФормирования, ТехническаяОшибка, ПровереноКарточек, КарточекСПроблемами, НайденоПроблем, СтрокПолногоРезультата, ЕстьОшибка, Отказ);
		Если ЕстьОшибка Тогда Элементы.ТехническаяОшибка.Видимость = Истина;
		Иначе
			Элементы.ТехническаяОшибка.Видимость = Ложь;
			ПолныйРезультат.Очистить();
			Для Каждого С Из Результат Цикл НР=ПолныйРезультат.Добавить(); ЗаполнитьЗначенияСвойств(НР,С); КонецЦикла;
			СтрокПолногоРезультата = ПолныйРезультат.Количество(); СтрокОтображается = Результат.Количество();
			СводкаОб = ОтчетОбъект.ПостроитьСводку(Результат, ПровереноКарточек);
			Сводка.Очистить(); Для Каждого С Из СводкаОб Цикл НР=Сводка.Добавить(); ЗаполнитьЗначенияСвойств(НР,С); КонецЦикла;
		КонецЕсли;
	Иначе ТехническаяОшибка = "Объект отчёта не найден."; ЕстьОшибка = Истина; Элементы.ТехническаяОшибка.Видимость = Истина;
	КонецЕсли;
