// Модуль объекта внешнего отчёта «Контроль заполнения номенклатуры»
// Конфигурация: УправлениеТорговлей 11.5.22.129 (платформа 8.3.27.1559)
//
// ВСЕ реквизиты подтверждены через MCP (get_object_structure, Catalog.Номенклатура)
//   1c_get_object_structure(object_name="Номенклатура", object_type="Catalog")
//
// Проверенные реквизиты (MCP):
//   StandardAttribute.Code       — Код (строка, 11)
//   StandardAttribute.Description — Наименование (строка, 100)
//   StandardAttribute.DeletionMark — ПометкаУдаления (булево)
//   StandardAttribute.IsFolder    — ЭтоГруппа (булево)
//   StandardAttribute.Parent      — Родитель (СправочникСсылка.Номенклатура)
//   Attribute.Артикул             — Артикул (строка, 50)
//   Attribute.ВидНоменклатуры     — Вид номенклатуры (СправочникСсылка.ВидыНоменклатуры)
//   Attribute.ЕдиницаИзмерения    — Единица хранения (СправочникСсылка.УпаковкиЕдиницыИзмерения)
//   Attribute.СтавкаНДС           — Ставка НДС (СправочникСсылка.СтавкиНДС)
//   Attribute.ТоварнаяКатегория   — Товарная категория (СправочникСсылка.ТоварныеКатегории)
//   Attribute.ГруппаФинансовогоУчета — Группа настроек фин. учета
//   Attribute.ТипНоменклатуры     — Тип номенклатуры (ПеречислениеСсылка.ТипыНоменклатуры)
//   Attribute.НаименованиеПолное  — Наименование для печати (строка, 1024)
//   Attribute.КодДляПоиска        — Код для поиска (строка, 11)
//   Attribute.Производитель       — Производитель (СправочникСсылка.Производители)
//   Attribute.ЦеноваяГруппа       — Ценовая группа (СправочникСсылка.ЦеновыеГруппы)
//
// Запросы проверены через MCP validate_query (все три запроса) и execute_query (основной + дубли наименований).

#Область ПрограммныйИнтерфейс

// Параметры отчёта:
//   УчитыватьПомеченныеНаУдаление (Булево) — Ложь по умолчанию
//   УчитыватьГруппы             (Булево) — Ложь по умолчанию
//   ТолькоСПроблемами           (Булево) — Ложь по умолчанию
//   МаксимальноеКоличествоСтрок (Число)  — 1000 по умолчанию

#КонецОбласти

#Область ТекстыЗапросов

// Текст основного запроса.
// Параметры:
//   УчитыватьПомеченные — Булево
//   УчитыватьГруппы    — Булево
//   МаксСтрок          — Число
// Возвращает: Строка
//
Функция ТекстОсновногоЗапроса(УчитыватьПомеченные, УчитыватьГруппы, МаксСтрок) Экспорт

	Текст = "ВЫБРАТЬ ПЕРВЫЕ " + МаксСтрок + "
	|	Номенклатура.Ссылка           КАК Ссылка,
	|	Номенклатура.Код              КАК Код,
	|	Номенклатура.Наименование     КАК Наименование,
	|	Номенклатура.Родитель         КАК Родитель,
	|	Номенклатура.ЭтоГруппа        КАК ЭтоГруппа,
	|	Номенклатура.ПометкаУдаления  КАК ПометкаУдаления,
	|	Номенклатура.Артикул          КАК Артикул,
	|	Номенклатура.ВидНоменклатуры  КАК ВидНоменклатуры,
	|	Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Номенклатура.СтавкаНДС        КАК СтавкаНДС,
	|	Номенклатура.ТоварнаяКатегория КАК ТоварнаяКатегория,
	|	Номенклатура.ГруппаФинансовогоУчета КАК ГруппаФинансовогоУчета,
	|	Номенклатура.ТипНоменклатуры  КАК ТипНоменклатуры,
	|	Номенклатура.НаименованиеПолное КАК НаименованиеПолное,
	|	Номенклатура.Производитель    КАК Производитель,
	|	Номенклатура.ЦеноваяГруппа    КАК ЦеноваяГруппа,
	|	Номенклатура.КодДляПоиска     КАК КодДляПоиска
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	ИСТИНА";

	Если НЕ УчитыватьГруппы Тогда
		Текст = Текст + "
		|	И Номенклатура.ЭтоГруппа = ЛОЖЬ";
	КонецЕсли;

	Если НЕ УчитыватьПомеченные Тогда
		Текст = Текст + "
		|	И НЕ Номенклатура.ПометкаУдаления";
	КонецЕсли;

	Текст = Текст + "
	|УПОРЯДОЧИТЬ ПО
	|	Номенклатура.Наименование";

	Возврат Текст;

КонецФункции

// Текст запроса дублей наименований. Возвращает: Строка
//
Функция ТекстЗапросаДублейНаименований() Экспорт

	Возврат
	"ВЫБРАТЬ
	|	Номенклатура.Наименование КАК Наименование,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Номенклатура.Ссылка) КАК КоличествоДублей
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Наименование <> ""
	|	И НЕ Номенклатура.ЭтоГруппа
	|	И НЕ Номенклатура.ПометкаУдаления
	|СГРУППИРОВАТЬ ПО
	|	Номенклатура.Наименование
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Номенклатура.Ссылка) > 1";

КонецФункции

// Текст запроса дублей кодов. Возвращает: Строка
//
Функция ТекстЗапросаДублейКодов() Экспорт

	Возврат
	"ВЫБРАТЬ
	|	Номенклатура.Код КАК Код,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Номенклатура.Ссылка) КАК КоличествоДублей
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	НЕ Номенклатура.ЭтоГруппа
	|	И НЕ Номенклатура.ПометкаУдаления
	|СГРУППИРОВАТЬ ПО
	|	Номенклатура.Код
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Номенклатура.Ссылка) > 1";

КонецФункции

#КонецОбласти

#Область ОбработкаРезультатов

// Создаёт таблицу для хранения найденных проблем.
// Возвращает: ТаблицаЗначений
//
Функция СоздатьТаблицуРезультата() Экспорт

	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Ссылка",             Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТЗ.Колонки.Добавить("Код",                Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("Наименование",        Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("Родитель",            Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТЗ.Колонки.Добавить("Проблема",            Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("ПроверяемыйРеквизит", Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("ТекущееЗначение",     Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("Рекомендация",        Новый ОписаниеТипов("Строка"));
	Возврат ТЗ;

КонецФункции

// Добавляет строку с проблемой в таблицу результата.
// Параметры:
//   ТЗ       — ТаблицаЗначений
//   Данные   — Структура (поля из запроса)
//   Проблема — Строка
//   Реквизит — Строка
//   Значение — Строка
//   Совет    — Строка
//
Процедура ДобавитьПроблему(ТЗ, Данные, Проблема, Реквизит, Значение, Совет) Экспорт

	Стр = ТЗ.Добавить();
	Стр.Ссылка             = Данные.Ссылка;
	Стр.Код                = Данные.Код;
	Стр.Наименование       = Данные.Наименование;
	Стр.Родитель           = Данные.Родитель;
	Стр.Проблема           = Проблема;
	Стр.ПроверяемыйРеквизит = Реквизит;
	Стр.ТекущееЗначение    = Значение;
	Стр.Рекомендация       = Совет;

КонецПроцедуры

// Выполняет все проверки для одной строки данных.
// Параметры:
//   Данные       — Структура
//   ТЗ           — ТаблицаЗначений (результат)
//   ДуплиНаим    — ТаблицаЗначений (дубли наименований)
//   ДуплиКодов   — ТаблицаЗначений (дубли кодов)
//
Процедура ВыполнитьПроверки(Данные, ТЗ, ДуплиНаим, ДуплиКодов) Экспорт

	// 1. Пустое наименование
	Если НЕ ЗначениеЗаполнено(Данные.Наименование) Тогда
		ДобавитьПроблему(ТЗ, Данные, "Пустое наименование", "Наименование", "",
			"Заполните наименование элемента.");
	КонецЕсли;

	// 2. Помечен на удаление
	Если Данные.ПометкаУдаления Тогда
		ДобавитьПроблему(ТЗ, Данные, "Элемент помечен на удаление", "ПометкаУдаления", "Да",
			"Снимите пометку удаления или удалите элемент окончательно.");
	КонецЕсли;

	// 3. Дубли наименования
	Если ДуплиНаим <> Неопределено Тогда
		СтрДубля = ДуплиНаим.Найти(Данные.Наименование, "Наименование");
		Если СтрДубля <> Неопределено Тогда
			ДобавитьПроблему(ТЗ, Данные,
				"Дубликат наименования (ещё " + (СтрДубля.КоличествоДублей - 1) + " шт.)",
				"Наименование", Данные.Наименование,
				"Проверьте элементы с одинаковым наименованием.");
		КонецЕсли;
	КонецЕсли;

	// 4. Дубли кода
	Если ДуплиКодов <> Неопределено И ЗначениеЗаполнено(Данные.Код) Тогда
		СтрДубляК = ДуплиКодов.Найти(Данные.Код, "Код");
		Если СтрДубляК <> Неопределено Тогда
			ДобавитьПроблему(ТЗ, Данные,
				"Дубликат кода (ещё " + (СтрДубляК.КоличествоДублей - 1) + " шт.)",
				"Код", Данные.Код,
				"Проверьте элементы с одинаковым кодом.");
		КонецЕсли;
	КонецЕсли;

	// 5. Элемент вне группы
	Если НЕ Данные.ЭтоГруппа И НЕ ЗначениеЗаполнено(Данные.Родитель) Тогда
		ДобавитьПроблему(ТЗ, Данные, "Элемент вне группы", "Родитель", "",
			"Переместите элемент в соответствующую группу.");
	КонецЕсли;

	// 6. Артикул
	Если НЕ ЗначениеЗаполнено(Данные.Артикул) Тогда
		ДобавитьПроблему(ТЗ, Данные, "Не заполнен артикул", "Артикул", "",
			"Укажите артикул номенклатуры.");
	КонецЕсли;

	// 7. Вид номенклатуры
	Если НЕ ЗначениеЗаполнено(Данные.ВидНоменклатуры) Тогда
		ДобавитьПроблему(ТЗ, Данные, "Не заполнен вид номенклатуры", "ВидНоменклатуры", "",
			"Выберите вид номенклатуры (Справочник.ВидыНоменклатуры).");
	КонецЕсли;

	// 8. Единица измерения
	Если НЕ ЗначениеЗаполнено(Данные.ЕдиницаИзмерения) Тогда
		ДобавитьПроблему(ТЗ, Данные, "Не заполнена единица хранения", "ЕдиницаИзмерения", "",
			"Выберите единицу хранения (Справочник.УпаковкиЕдиницыИзмерения).");
	КонецЕсли;

	// 9. Ставка НДС
	Если НЕ ЗначениеЗаполнено(Данные.СтавкаНДС) Тогда
		ДобавитьПроблему(ТЗ, Данные, "Не заполнена ставка НДС", "СтавкаНДС", "",
			"Выберите ставку НДС (Справочник.СтавкиНДС).");
	КонецЕсли;

	// 10. Товарная категория
	Если НЕ ЗначениеЗаполнено(Данные.ТоварнаяКатегория) Тогда
		ДобавитьПроблему(ТЗ, Данные, "Не заполнена товарная категория", "ТоварнаяКатегория", "",
			"Выберите товарную категорию (Справочник.ТоварныеКатегории).");
	КонецЕсли;

	// 11. Группа фин. учёта
	Если НЕ ЗначениеЗаполнено(Данные.ГруппаФинансовогоУчета) Тогда
		ДобавитьПроблему(ТЗ, Данные, "Не заполнена группа фин. учёта", "ГруппаФинансовогоУчета", "",
			"Выберите группу (Справочник.ГруппыФинансовогоУчетаНоменклатуры).");
	КонецЕсли;

	// 12. Тип номенклатуры
	Если НЕ ЗначениеЗаполнено(Данные.ТипНоменклатуры) Тогда
		ДобавитьПроблему(ТЗ, Данные, "Не заполнен тип номенклатуры", "ТипНоменклатуры", "",
			"Тип копируется из вида номенклатуры — проверьте ВидНоменклатуры.");
	КонецЕсли;

	// 13. Наименование для печати
	Если НЕ ЗначениеЗаполнено(Данные.НаименованиеПолное) Тогда
		ДобавитьПроблему(ТЗ, Данные, "Не заполнено наименование для печати", "НаименованиеПолное", "",
			"Заполните полное наименование для печатных форм.");
	КонецЕсли;

	// 14. Код для поиска
	Если НЕ ЗначениеЗаполнено(Данные.КодДляПоиска) Тогда
		ДобавитьПроблему(ТЗ, Данные, "Не заполнен код для поиска", "КодДляПоиска", "",
			"Заполните код для быстрого поиска.");
	КонецЕсли;

	// 15. Производитель
	Если НЕ ЗначениеЗаполнено(Данные.Производитель) Тогда
		ДобавитьПроблему(ТЗ, Данные, "Не заполнен производитель", "Производитель", "",
			"Выберите производителя (Справочник.Производители).");
	КонецЕсли;

	// 16. Ценовая группа
	Если НЕ ЗначениеЗаполнено(Данные.ЦеноваяГруппа) Тогда
		ДобавитьПроблему(ТЗ, Данные, "Не заполнена ценовая группа", "ЦеноваяГруппа", "",
			"Выберите ценовую группу (Справочник.ЦеновыеГруппы).");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ФормированиеОтчета

// Основная процедура формирования отчёта.
// Параметры:
//   ТабДок    — ТабличныйДокумент (выходной)
//   Настройки — Структура (УчитыватьПомеченныеНаУдаление, УчитыватьГруппы,
//              ТолькоСПроблемами, МаксимальноеКоличествоСтрок)
//   Отказ     — Булево (выходной)
//
Процедура СформироватьОтчет(ТабДок, Настройки, Отказ) Экспорт

	Попытка
		ТабДок.Очистить();

		// Получение дублей
		ДуплиНаим = Неопределено;
		Попытка
			ЗДН = Новый Запрос(ТекстЗапросаДублейНаименований());
			ДуплиНаим = ЗДН.Выполнить().Выгрузить();
		Исключение
		КонецПопытки;

		ДуплиКодов = Неопределено;
		Попытка
			ЗДК = Новый Запрос(ТекстЗапросаДублейКодов());
			ДуплиКодов = ЗДК.Выполнить().Выгрузить();
		Исключение
		КонецПопытки;

		// Основной запрос
		Текст = ТекстОсновногоЗапроса(
			Настройки.УчитыватьПомеченныеНаУдаление,
			Настройки.УчитыватьГруппы,
			Настройки.МаксимальноеКоличествоСтрок);

		Запрос = Новый Запрос(Текст);
		Выборка = Запрос.Выполнить().Выбрать();

		// Обработка
		ТЗ = СоздатьТаблицуРезультата();
		Пока Выборка.Следующий() Цикл
			Данные = Новый Структура;
			Данные.Вставить("Ссылка",                 Выборка.Ссылка);
			Данные.Вставить("Код",                    Выборка.Код);
			Данные.Вставить("Наименование",           Выборка.Наименование);
			Данные.Вставить("Родитель",               Выборка.Родитель);
			Данные.Вставить("ЭтоГруппа",              Выборка.ЭтоГруппа);
			Данные.Вставить("ПометкаУдаления",        Выборка.ПометкаУдаления);
			Данные.Вставить("Артикул",                Выборка.Артикул);
			Данные.Вставить("ВидНоменклатуры",        Выборка.ВидНоменклатуры);
			Данные.Вставить("ЕдиницаИзмерения",       Выборка.ЕдиницаИзмерения);
			Данные.Вставить("СтавкаНДС",              Выборка.СтавкаНДС);
			Данные.Вставить("ТоварнаяКатегория",       Выборка.ТоварнаяКатегория);
			Данные.Вставить("ГруппаФинансовогоУчета", Выборка.ГруппаФинансовогоУчета);
			Данные.Вставить("ТипНоменклатуры",        Выборка.ТипНоменклатуры);
			Данные.Вставить("НаименованиеПолное",     Выборка.НаименованиеПолное);
			Данные.Вставить("Производитель",          Выборка.Производитель);
			Данные.Вставить("ЦеноваяГруппа",          Выборка.ЦеноваяГруппа);
			Данные.Вставить("КодДляПоиска",           Выборка.КодДляПоиска);

			Если Настройки.ТолькоСПроблемами Тогда
				ВыполнитьПроверки(Данные, ТЗ, ДуплиНаим, ДуплиКодов);
			Иначе
				ТЗПроблем = СоздатьТаблицуРезультата();
				ВыполнитьПроверки(Данные, ТЗПроблем, ДуплиНаим, ДуплиКодов);
				Если ТЗПроблем.Количество() = 0 Тогда
					ДобавитьСтрокуБезПроблем(ТЗ, Данные);
				Иначе
					Для Каждого СтрПроблемы Из ТЗПроблем Цикл
						НовСтр = ТЗ.Добавить();
						ЗаполнитьЗначенияСвойств(НовСтр, СтрПроблемы);
					КонецЦикла;
				КонецЕсли;
			КонецЕсли
		КонецЦикла;

		ВывестиРезультат(ТабДок, ТЗ);

	Исключение
		Отказ = Истина;
		ТекстОшибки = "Ошибка формирования отчёта: " + ОписаниеОшибки();
		Сообщить(ТекстОшибки);
		ЗаписьЖурналаРегистрации("Отчет.КонтрольЗаполненияНоменклатуры",
			УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
	КонецПопытки;

КонецПроцедуры



// Добавляет строку без проблем в таблицу результата.
// Параметры:
//   ТЗ     — ТаблицаЗначений
//   Данные — Структура (поля из запроса)
//
Процедура ДобавитьСтрокуБезПроблем(ТЗ, Данные) Экспорт

	Стр = ТЗ.Добавить();
	Стр.Ссылка             = Данные.Ссылка;
	Стр.Код                = Данные.Код;
	Стр.Наименование       = Данные.Наименование;
	Стр.Родитель           = Данные.Родитель;
	Стр.Проблема           = "Проблем не обнаружено";
	Стр.ПроверяемыйРеквизит = "";
	Стр.ТекущееЗначение    = "";
	Стр.Рекомендация       = "";

КонецПроцедуры
// Выводит таблицу результата в табличный документ.
// Параметры:
//   ТабДок — ТабличныйДокумент
//   ТЗ     — ТаблицаЗначений
//
Процедура ВывестиРезультат(ТабДок, ТЗ) Экспорт

	ТабДок.Очистить();

	// Заголовок
	Обл = ТабДок.Области.Добавить();
	Обл.Объединить(1, 1, 1, 8);
	Обл.Текст = "Контроль заполнения номенклатуры";
	Обл.Шрифт = Новый Шрифт(ТабДок.Шрифт, , Истина, , 14);

	// Шапка
	ОблШ = ТабДок.Области.Добавить();
	Заголовки = Новый Массив;
	Заголовки.Добавить("Ссылка"); Заголовки.Добавить("Код");
	Заголовки.Добавить("Наименование"); Заголовки.Добавить("Родитель");
	Заголовки.Добавить("Проблема"); Заголовки.Добавить("Проверяемый реквизит");
	Заголовки.Добавить("Текущее значение"); Заголовки.Добавить("Рекомендация");

	Для ИндексКолонки = 0 По Заголовки.Количество() - 1 Цикл
		ОблШ.Область(1, ИндексКолонки + 1).Текст = Заголовки[ИндексКолонки];
		ОблШ.Область(1, ИндексКолонки + 1).Шрифт = Новый Шрифт(, , Истина);
	КонецЦикла;

	// Строки данных
	Для Каждого Стр Из ТЗ Цикл
		ОблС = ТабДок.Области.Добавить();
		ЯчейкаСсылки = ОблС.Область(1, 1);
		ЯчейкаСсылки.Текст = Строка(Стр.Ссылка);
		ЯчейкаСсылки.Расшифровка = Стр.Ссылка;
		ОблС.Область(1, 2).Текст = Стр.Код;
		ОблС.Область(1, 3).Текст = Стр.Наименование;
		ОблС.Область(1, 4).Текст = Строка(Стр.Родитель);
		ОблС.Область(1, 5).Текст = Стр.Проблема;
		ОблС.Область(1, 6).Текст = Стр.ПроверяемыйРеквизит;
		ОблС.Область(1, 7).Текст = Стр.ТекущееЗначение;
		ОблС.Область(1, 8).Текст = Стр.Рекомендация;
	КонецЦикла;

	// Итого
	ОблИ = ТабДок.Области.Добавить();
	ОблИ.Объединить(1, 1, 1, 4);
	ОблИ.Текст = "Всего проблем: " + ТЗ.Количество();
	ОблИ.Шрифт = Новый Шрифт(, , Истина);

КонецПроцедуры

#КонецОбласти


#Область СовместимостьФормы

Процедура GenerateReport(Spreadsheet, Settings, Cancel) Экспорт

	НастройкиОтчета = Новый Структура;
	НастройкиОтчета.Вставить(
		"УчитыватьПомеченныеНаУдаление",
		Settings.IncludeDeletionMark);
	НастройкиОтчета.Вставить(
		"УчитыватьГруппы",
		Settings.IncludeGroups);
	НастройкиОтчета.Вставить(
		"ТолькоСПроблемами",
		Settings.OnlyWithProblems);
	НастройкиОтчета.Вставить(
		"МаксимальноеКоличествоСтрок",
		Settings.MaxRowCount);

	СформироватьОтчет(Spreadsheet, НастройкиОтчета, Cancel);

КонецПроцедуры

#КонецОбласти
