{
  "title": "Kontrol Audit",
  "properties": {
    "autoTitle": false
  },
  "events": {
    "OnCreateAtServer": "OnCreateAtServer"
  },
  "attributes": [
    { "name": "Object", "type": "ExternalReportObject.KontrolAudit", "main": true },
    { "name": "Result", "type": "SpreadsheetDocument" },
    { "name": "IncludeDeletionMark", "type": "boolean" },
    { "name": "IncludeGroups", "type": "boolean" },
    { "name": "OnlyWithProblems", "type": "boolean" },
    { "name": "MaxRowCount", "type": "decimal(6,0,nonneg)" }
  ],
  "commands": [
    { "name": "Generate", "action": "Generate", "title": "Generate" }
  ],
  "elements": [
    { "group": "vertical", "name": "GroupParams", "title": "Parameters", "children": [
      { "check": "IncludeDeletionMark", "path": "IncludeDeletionMark", "title": "Include deletion mark" },
      { "check": "IncludeGroups", "path": "IncludeGroups", "title": "Include groups" },
      { "check": "OnlyWithProblems", "path": "OnlyWithProblems", "title": "Only with problems" },
      { "input": "MaxRowCount", "path": "MaxRowCount", "title": "Max row count" }
    ]},
    { "spreadsheet": "Result", "path": "Result", "titleLocation": "none", "horizontalStretch": true },
    { "autoCmdBar": "FormCmdBar", "children": [
      { "button": "Generate", "command": "Generate", "defaultButton": true, "title": "Generate" },
      { "button": "Close", "stdCommand": "Close" }
    ]}
  ]
}